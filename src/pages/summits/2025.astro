---
/**
 * Example Robotics Summit 2025 archive page
 * Three-day program with recording placeholders, speakers and partners.
 * All content is fictional demo data.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProgramDay from '@/components/ProgramDay.astro';
import SpeakerCard from '@/components/SpeakerCard.astro';
import VideoCard from '@/components/VideoCard.astro';
import SponsorGrid from '@/components/SponsorGrid.astro';
import VideoPlaceholder from '@/components/VideoPlaceholder.astro';
import VideoModal from '@/components/VideoModal.astro';
import { 
  SUMMITS, 
  SUMMIT_2025_PROGRAM, 
  SUMMIT_2025_VIDEOS,
  SPEAKERS_2025, 
  SPONSORS_2025,
  getKeynoteSpeakers,
} from '@/lib/summits-data';
import { LINKS } from '@/lib/constants';

const summit = SUMMITS['2025'];
const keynoteSpeakers = getKeynoteSpeakers('2025');

// Tab configuration
const tabs = [
  { id: 'program', label: 'Program', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { id: 'speakers', label: 'Speakers', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { id: 'sponsors', label: 'Partners', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { id: 'watch', label: 'Recordings', icon: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z' },
];
---

<BaseLayout 
  title={summit.name} 
  description={`${summit.name}: a fictional ${summit.stats?.sessions}-session online event with ${summit.stats?.speakers} speakers and attendees from ${summit.stats?.countries} countries. Demo content only.`}
>
  {/* Hero Section */}
  <section class="relative overflow-hidden bg-vrc-navy text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-vrc-navy via-vrc-blue-dark to-vrc-blue"></div>
    <div class="absolute inset-0 opacity-25" style="background-image: radial-gradient(circle at 20% 30%, rgba(22,163,74,0.35), transparent 50%), radial-gradient(circle at 80% 70%, rgba(59,130,246,0.3), transparent 50%);"></div>

    <div class="relative container mx-auto px-4 py-20 lg:py-28">
      <a href="/summits" class="inline-flex items-center gap-2 text-white/60 hover:text-white mb-8 transition-colors text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        All Summits
      </a>

      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-vrc-green/15 border border-vrc-green/40 rounded-full text-vrc-green text-xs font-semibold uppercase tracking-wider mb-6">
          Past Edition · Recording Placeholders
        </div>
        <h1 class="font-heading font-bold text-5xl md:text-6xl lg:text-7xl leading-[0.95] mb-6">
          Example Robotics
          <span class="block text-transparent bg-clip-text bg-gradient-to-r from-vrc-green via-emerald-400 to-teal-300">Summit 2025</span>
        </h1>
        <p class="text-lg md:text-xl text-white/75 max-w-2xl mb-8 leading-relaxed">{summit.tagline}</p>
        <div class="flex flex-wrap gap-6 text-white/70 mb-10 text-sm">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            {summit.dates}
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
            {summit.location}
          </span>
        </div>

        {summit.stats && (
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl">
            <div>
              <div class="font-heading font-bold text-4xl md:text-5xl text-vrc-green tabular-nums">{summit.stats.attendees}</div>
              <div class="text-xs uppercase tracking-wider text-white/60 mt-1">Attendees</div>
            </div>
            <div>
              <div class="font-heading font-bold text-4xl md:text-5xl text-vrc-green tabular-nums">{summit.stats.countries}</div>
              <div class="text-xs uppercase tracking-wider text-white/60 mt-1">Countries</div>
            </div>
            <div>
              <div class="font-heading font-bold text-4xl md:text-5xl text-vrc-green tabular-nums">{summit.stats.sessions}</div>
              <div class="text-xs uppercase tracking-wider text-white/60 mt-1">Sessions</div>
            </div>
            <div>
              <div class="font-heading font-bold text-4xl md:text-5xl text-vrc-green tabular-nums">{summit.stats.speakers}</div>
              <div class="text-xs uppercase tracking-wider text-white/60 mt-1">Speakers</div>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
  
  {/* Tab Navigation */}
  <div class="sticky top-[72px] z-40 bg-white border-b border-gray-200 shadow-sm">
    <div class="container mx-auto px-4">
      <nav class="flex gap-1 overflow-x-auto scrollbar-hide py-2" aria-label="Summit sections">
        {tabs.map((tab, idx) => (
          <button
            class={`summit-tab flex items-center gap-2 px-6 py-3 font-semibold text-sm uppercase tracking-wide whitespace-nowrap rounded-lg transition-colors ${idx === 0 ? 'bg-vrc-blue text-white' : 'text-gray-600 hover:bg-gray-100'}`}
            data-tab={tab.id}
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tab.icon} />
            </svg>
            {tab.label}
          </button>
        ))}
      </nav>
    </div>
  </div>
  
  {/* Tab Content */}
  <div class="min-h-screen">
    {/* Program Tab */}
    <section id="tab-program" class="summit-tab-content py-16">
      <div class="container mx-auto px-4">
        <h2 class="section-title mb-4">{SUMMIT_2025_PROGRAM.length}-Day Program</h2>
        <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
          Open a day to see its sessions. Times are in UTC, and each recording slot shows a placeholder.
        </p>
        
        <div class="max-w-4xl mx-auto space-y-4">
          {SUMMIT_2025_PROGRAM.map((day, idx) => (
            <ProgramDay programDay={day} defaultOpen={idx === 0} />
          ))}
        </div>
      </div>
    </section>
    
    {/* Speakers Tab */}
    <section id="tab-speakers" class="summit-tab-content py-16 hidden">
      <div class="container mx-auto px-4">
        {/* Keynote Speakers */}
        <h2 class="section-title mb-4">{keynoteSpeakers.length === 1 ? 'Keynote Speaker' : 'Keynote Speakers'}</h2>
        <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
          The first edition had a single keynote, in the middle of Day 2: a glaciologist on keeping instruments working on moving ice.
        </p>
        
        <div class={`grid gap-6 mx-auto mb-16 ${keynoteSpeakers.length === 1 ? 'max-w-sm' : 'md:grid-cols-2 lg:grid-cols-3 max-w-5xl'}`}>
          {keynoteSpeakers.map(speaker => (
            <SpeakerCard speaker={speaker} size="lg" />
          ))}
        </div>
        
        {/* All Speakers */}
        <h3 class="text-2xl font-heading font-semibold text-center mb-8">All Speakers</h3>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 max-w-6xl mx-auto">
          {SPEAKERS_2025.filter(s => !s.isKeynote).map(speaker => (
            <SpeakerCard speaker={speaker} size="sm" />
          ))}
        </div>
      </div>
    </section>
    
    {/* Sponsors Tab */}
    <section id="tab-sponsors" class="summit-tab-content py-16 hidden bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="section-title mb-4">Our Partners</h2>
        <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
          The fictional organisations that covered costs and lent a hand in 2025.
        </p>
        
        <div class="max-w-5xl mx-auto">
          <SponsorGrid sponsors={SPONSORS_2025} />
        </div>
        
        {/* Become a Sponsor CTA */}
        <div class="text-center mt-16">
          <p class="text-gray-600 mb-4">Would your organisation like to support a future edition?</p>
          <a href={LINKS.contact.mailto} class="inline-flex items-center gap-2 px-6 py-3 bg-vrc-blue text-white font-semibold uppercase tracking-wider hover:bg-vrc-blue-dark transition-colors rounded-lg">
            Write to Us
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>
    
    {/* All Videos Tab */}
    <section id="tab-watch" class="summit-tab-content py-16 hidden">
      <div class="container mx-auto px-4">
        <h2 class="section-title mb-4">All Recordings</h2>
        <p class="text-center text-gray-600 mb-8 max-w-2xl mx-auto">
          {SUMMIT_2025_VIDEOS.length} recording slots from the first edition. Filter by format below.
        </p>
        
        {/* Filter Tabs */}
        <div class="flex flex-wrap justify-center gap-2 mb-12">
          <button class="video-filter px-4 py-2 bg-vrc-blue text-white text-sm font-semibold rounded-full" data-filter="all">
            All
          </button>
          <button class="video-filter px-4 py-2 bg-gray-200 text-gray-700 text-sm font-semibold rounded-full hover:bg-gray-300" data-filter="keynote">
            Keynotes
          </button>
          <button class="video-filter px-4 py-2 bg-gray-200 text-gray-700 text-sm font-semibold rounded-full hover:bg-gray-300" data-filter="panel">
            Panels
          </button>
          <button class="video-filter px-4 py-2 bg-gray-200 text-gray-700 text-sm font-semibold rounded-full hover:bg-gray-300" data-filter="talk">
            Talks
          </button>
          <button class="video-filter px-4 py-2 bg-gray-200 text-gray-700 text-sm font-semibold rounded-full hover:bg-gray-300" data-filter="pitch">
            Pitches
          </button>
        </div>
        
        {/* Video Grid */}
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-7xl mx-auto" id="video-grid">
          {SUMMIT_2025_VIDEOS.sort((a, b) => a.day - b.day || a.order - b.order).map(video => (
            <div class="video-item" data-type={video.type}>
              <VideoCard video={video} />
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
  
  {/* Full set placeholder */}
  <section class="py-16 bg-gray-900">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-white mb-4">
          The Whole Edition in One Place
        </h2>
        <p class="text-white/70 mb-8 max-w-xl mx-auto">
          On a real site this space would hold a single player with every session in order. Here it is a placeholder, like the rest of the recordings.
        </p>
        <VideoPlaceholder
          title="Example Robotics Summit 2025: full session list"
          caption={`${SUMMIT_2025_VIDEOS.length} placeholder recordings across ${SUMMIT_2025_PROGRAM.length} days.`}
        />
      </div>
    </div>
  </section>
  
  {/* Next Summit CTA */}
  <section class="py-16 bg-vrc-blue">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-white mb-4">
        See the 2026 Edition
      </h2>
      <p class="text-white/80 mb-8 max-w-xl mx-auto">
        The second edition ran May 19-21, 2026. Browse its program, its 24 speakers and its partners.
      </p>
      <a
        href="/summits/2026"
        class="inline-flex items-center gap-2 px-8 py-4 bg-white text-vrc-blue font-semibold uppercase tracking-wider hover:bg-gray-100 transition-colors rounded-lg"
      >
        View Summit 2026
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <VideoModal />
</BaseLayout>

<script>
  // Tab switching functionality
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.summit-tab');
    const contents = document.querySelectorAll('.summit-tab-content');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-tab');
        
        // Update tab styles
        tabs.forEach(t => {
          t.classList.remove('bg-vrc-blue', 'text-white');
          t.classList.add('text-gray-600', 'hover:bg-gray-100');
        });
        tab.classList.add('bg-vrc-blue', 'text-white');
        tab.classList.remove('text-gray-600', 'hover:bg-gray-100');
        
        // Show/hide content
        contents.forEach(content => {
          if (content.id === `tab-${targetId}`) {
            content.classList.remove('hidden');
          } else {
            content.classList.add('hidden');
          }
        });
        
        // Scroll to content
        const targetContent = document.getElementById(`tab-${targetId}`);
        if (targetContent) {
          window.scrollTo({
            top: targetContent.offsetTop - 140,
            behavior: 'smooth'
          });
        }
      });
    });
    
    // Video filtering
    const filterBtns = document.querySelectorAll('.video-filter');
    const videoItems = document.querySelectorAll('.video-item');
    
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        
        // Update button styles
        filterBtns.forEach(b => {
          b.classList.remove('bg-vrc-blue', 'text-white');
          b.classList.add('bg-gray-200', 'text-gray-700');
        });
        btn.classList.add('bg-vrc-blue', 'text-white');
        btn.classList.remove('bg-gray-200', 'text-gray-700');
        
        // Filter videos
        videoItems.forEach(item => {
          const type = item.getAttribute('data-type');
          if (filter === 'all' || type === filter) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });
    
    // Handle URL hash for direct tab navigation
    const openTabFromHash = () => {
      const hash = window.location.hash.replace('#', '');
      if (hash) {
        const targetTab = document.querySelector(`.summit-tab[data-tab="${hash}"]`) as HTMLElement;
        if (targetTab) targetTab.click();
      }
    };
    openTabFromHash();
    window.addEventListener('hashchange', openTabFromHash);
  });
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

