---
/**
 * The summits overview (#28): the next edition and every past one, each
 * linking to its page.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import Button from '@/components/ui/Button.astro';
import EditionCard from '@/components/site/EditionCard.astro';
import { editionChip, editionDates, getCurrentEdition, getEditions, getNow } from '@/lib/content';

const current = getCurrentEdition();
const chip = editionChip(current, getNow());
const past = getEditions().filter((e) => e.year !== current.year);
const eyebrow = 'font-mono text-xs tracking-[0.06em] text-vrc-muted';
---

<SiteLayout title="Summits" description={`Vert Robo Con Summit: ${current.dek}`}>
  <section class="px-4 pt-10 lg:px-8 lg:pt-14">
    <div class="mx-auto flex max-w-page flex-col gap-10">
      <div class="flex max-w-4xl flex-col gap-6">
        <span class={eyebrow}>SUMMITS · ANNUAL · ONLINE · FREE</span>
        <h1 class="m-0 font-heading text-[clamp(48px,8vw,96px)] font-semibold leading-[0.92] tracking-[-0.045em]">Vert Robo Con Summit</h1>
        <p class="m-0 max-w-[620px] text-xl text-vrc-ink-2">{current.dek}</p>
      </div>

      <a
        href={`/summits/${current.year}`}
        class="group flex flex-wrap items-end justify-between gap-6 rounded-3xl bg-vrc-navy p-8 text-white no-underline hover:text-white lg:p-12"
      >
        <span class="flex flex-col gap-4">
          <span class="inline-flex items-center gap-2 self-start rounded-full bg-vrc-navy-raised px-2.5 py-1 font-mono text-[11px] tracking-[0.06em] text-vrc-on-navy">
            <span aria-hidden="true" class:list={['h-1.5 w-1.5 rounded-full', chip.tone === 'green' ? 'bg-vrc-green' : chip.tone === 'amber' ? 'bg-vrc-amber' : 'bg-vrc-on-navy-muted']}></span>{chip.label}
          </span>
          <span class="font-heading text-[clamp(36px,5vw,64px)] font-semibold leading-none tracking-[-0.035em] group-hover:underline">Summit {current.year}</span>
          <span class="text-lg text-vrc-on-navy">{editionDates(current)} · {current.format} · {current.price}</span>
        </span>
        <span class="inline-flex min-h-12 items-center gap-2 rounded-xl bg-white px-5 font-medium text-vrc-ink">See Summit {current.year} →</span>
      </a>
    </div>
  </section>

  <section class="px-4 py-20 lg:px-8 lg:py-24">
    <div class="mx-auto flex max-w-page flex-col gap-10 rounded-[32px] bg-vrc-surface p-6 lg:p-12">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="flex flex-col gap-4">
          <span class={eyebrow}>ARCHIVE</span>
          <h2 class="m-0 font-heading text-[clamp(36px,4.6vw,56px)] font-semibold leading-[0.98] tracking-[-0.035em]">Past editions</h2>
        </div>
        <Button href="/watch" variant="secondary">All recordings</Button>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-4">
        {past.map((e) => <EditionCard edition={e} />)}
      </div>
    </div>
  </section>
</SiteLayout>
