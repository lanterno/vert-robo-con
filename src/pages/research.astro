---
/**
 * Research (#31), from ResearchV3: the white paper, its chapters and
 * authors, and the three codes the network works by.
 *
 * The PDF comes with #68, writing for the next edition with #59, and
 * "Ask the authors" with the contact form in #54.
 */
import { getCollection, getEntry, render } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Button from '@/components/ui/Button.astro';
import Chip from '@/components/ui/Chip.astro';
import Icon from '@/components/ui/Icon.astro';
import PersonAvatar from '@/components/site/PersonAvatar.astro';
import { creditedAs, getAuthors, getVideos } from '@/lib/content';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

const paper = await getEntry('documents', 'white-paper-2025');
if (!paper) throw new Error('The 2025 white paper is missing from src/content/documents');
const { headings } = await render(paper);
const chapters = headings.filter((h: MarkdownHeading) => h.depth === 2);
const authors = getAuthors(2025);
const explainer = getVideos().find((v) => v.kind === 'explainer');

// The codes, in the order the site links to them.
const codeOrder = ['principles', 'deployment-code', 'code-of-conduct'];
const all = await getCollection('documents');
const codes = codeOrder
  .map((id) => all.find((d: CollectionEntry<'documents'>) => d.id === id))
  .filter((d): d is CollectionEntry<'documents'> => d !== undefined)
  .map((d) => ({ doc: d, href: `/${d.id}` }));

const eyebrow = 'font-mono text-xs tracking-[0.06em] text-vrc-muted';
---

<SiteLayout
  title="Research"
  description="Working Notes on Climate Robots: a community-written guide to what robots do after their first season."
>
  <section class="px-4 pt-10 lg:px-8 lg:pt-14">
    <div class="mx-auto flex max-w-page flex-wrap items-center gap-x-16 gap-y-10">
      <div class="flex max-w-2xl flex-[1.4_1_520px] flex-col gap-5">
        <span class={eyebrow}>WHITE PAPER · 2025 EDITION · OPEN &amp; COMMUNITY-WRITTEN</span>
        <h1 class="m-0 font-heading text-[clamp(40px,6.5vw,76px)] font-semibold leading-[0.94] tracking-[-0.045em]">
          Where robots help the climate, and where they don’t
        </h1>
        <p class="m-0 text-xl text-vrc-ink-2">
          A community-written guide to robots in climate work after the first season: what is deployed, what it costs to run,
          how it fails and how to buy well.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <Button href="/research/white-paper/2025">Read online <Icon name="arrow-right" /></Button>
          <span class="inline-flex items-center gap-2 text-[15px] text-vrc-muted"><Icon name="download" />PDF <Chip>Coming soon</Chip></span>
        </div>
      </div>
      <div class="relative flex flex-[1_1_300px] flex-col gap-3">
        <img src="/images/v3/white-paper.svg" alt="" class="w-full rounded-3xl bg-vrc-blue-tint object-cover" />
        <span class={eyebrow}>{chapters.length} CHAPTERS</span>
      </div>
    </div>
  </section>

  <section aria-labelledby="chapters" class="px-4 py-16 lg:px-8 lg:py-20">
    <div class="mx-auto flex max-w-page flex-col gap-8">
      <div class="flex max-w-3xl flex-col gap-4">
        <h2 id="chapters" class="m-0 font-heading text-[clamp(32px,4.2vw,48px)] font-semibold leading-tight tracking-[-0.035em]">
          {chapters.length} chapters
        </h2>
        <p class="m-0 text-lg text-vrc-ink-2">
          Written for the people who buy, run and repair robots, with numbers from real deployments wherever members could
          share them.
        </p>
      </div>
      <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-4 p-0">
        {
          chapters.map((h: MarkdownHeading, i: number) => (
            <li>
              <a
                href={`/research/white-paper/2025#${h.slug}`}
                class="flex h-full flex-col gap-3 rounded-3xl border border-vrc-line p-7 text-vrc-ink no-underline transition-[transform,box-shadow] duration-200 hover:-translate-y-[3px] hover:text-vrc-ink hover:shadow-lift motion-reduce:transition-none motion-reduce:hover:translate-y-0"
              >
                <span class={eyebrow}>CHAPTER {String(i + 1).padStart(2, '0')}</span>
                <span class="font-heading text-2xl font-semibold tracking-[-0.02em]">{h.text}</span>
                <span class="mt-auto inline-flex items-center gap-1.5 font-medium text-vrc-blue">
                  Read <Icon name="arrow-right" />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    authors.length > 0 && (
      <section aria-labelledby="authors" class="bg-vrc-surface px-4 py-16 lg:px-8 lg:py-20">
        <div class="mx-auto flex max-w-page flex-col gap-6">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 id="authors" class="m-0 font-heading text-[clamp(32px,4.2vw,48px)] font-semibold leading-tight tracking-[-0.035em]">
              Who wrote it
            </h2>
            <span class={eyebrow}>{authors.length} AUTHORS</span>
          </div>
          <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-3 p-0">
            {authors.map((p) => (
              <li>
                <a href={`/people/${p.slug}`} class="flex h-full items-center gap-3 rounded-2xl bg-white p-3 text-vrc-ink no-underline hover:bg-vrc-surface-2 hover:text-vrc-ink">
                  <PersonAvatar person={p} size={48} class="h-12 w-12 rounded-xl" />
                  <span class="flex min-w-0 flex-col leading-snug">
                    <strong class="font-semibold">{creditedAs(p, 2025)}</strong>
                    <span class="text-sm text-vrc-muted">Author</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="m-0 flex flex-wrap items-center gap-2 text-[15px] text-vrc-muted">
            <Icon name="mail" />Ask the authors a question <Chip onSurface>Coming soon</Chip>
          </p>
        </div>
      </section>
    )
  }

  <section aria-labelledby="codes" class="px-4 py-16 lg:px-8 lg:py-20">
    <div class="mx-auto flex max-w-page flex-col gap-8">
      <div class="flex max-w-3xl flex-col gap-4">
        <h2 id="codes" class="m-0 font-heading text-[clamp(32px,4.2vw,48px)] font-semibold leading-tight tracking-[-0.035em]">
          How we work
        </h2>
        <p class="m-0 text-lg text-vrc-ink-2">
          Three short documents the network agreed on: how we judge a project, how robots go into the field, and how we treat
          each other.
        </p>
      </div>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-4 p-0">
        {
          codes.map(({ doc, href }) => (
            <li>
              <a
                href={href}
                class="flex h-full flex-col gap-3 rounded-3xl border border-vrc-line p-7 text-vrc-ink no-underline hover:bg-vrc-surface-2 hover:text-vrc-ink"
              >
                <span class={eyebrow}>{doc.data.eyebrow}</span>
                <span class="font-heading text-2xl font-semibold tracking-[-0.02em]">{doc.data.title}</span>
                <span class="mt-auto inline-flex items-center gap-1.5 font-medium text-vrc-blue">
                  Read <Icon name="arrow-right" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="next" class="px-4 pb-20 lg:px-8">
    <div class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-6 rounded-3xl bg-vrc-navy p-8 text-white lg:p-12">
      <div class="flex max-w-2xl flex-col gap-3">
        <span class="font-mono text-xs tracking-[0.06em] text-vrc-on-navy-muted">THE NEXT EDITION</span>
        <h2 id="next" class="m-0 font-heading text-[clamp(28px,3.4vw,40px)] font-semibold tracking-[-0.03em]">Write the next edition</h2>
        <p class="m-0 text-vrc-on-navy">
          The paper is written by members. Send a field note from your own deployment, suggest a chapter, or join the research
          team.
        </p>
      </div>
      <span class="inline-flex items-center gap-2 text-[15px] text-vrc-on-navy-muted">
        <Icon name="bell" />Propose a topic
        <span class="rounded-full bg-vrc-navy-raised px-2.5 py-1 font-mono text-[11px] font-medium tracking-[0.06em] text-vrc-on-navy">COMING SOON</span>
      </span>
    </div>
  </section>

  {
    explainer && (
      <section aria-labelledby="explainer" class="px-4 pb-20 lg:px-8">
        <div class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-6 rounded-3xl border border-vrc-line p-8">
          <div class="flex flex-col gap-2">
            <span id="explainer" class={eyebrow}>WATCH</span>
            <p class="m-0 max-w-xl text-lg text-vrc-ink-2">{explainer.title}: a short introduction to the paper and its chapters.</p>
          </div>
          <Button href={`/watch/${explainer.slug}`} variant="secondary">
            <Icon name="play" size={16} filled />Watch it
          </Button>
        </div>
      </section>
    )
  }
</SiteLayout>
