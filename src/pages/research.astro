---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VideoPlaceholder from '@/components/VideoPlaceholder.astro';
import { LINKS, SITE } from '@/lib/constants';

const topics = [
  { label: 'Field Trials', color: 'from-emerald-500 to-green-600' },
  { label: 'Spare Parts', color: 'from-blue-500 to-cyan-600' },
  { label: 'Five-Year Cost', color: 'from-amber-500 to-orange-500' },
  { label: 'Data Ownership', color: 'from-violet-500 to-purple-600' },
];

const contents = [
  { n: '1', title: 'Why field robots, and why now' },
  { n: '2', title: 'Five outdoor jobs, examined one by one' },
  { n: '3', title: 'What breaks: weather, dirt, batteries and people' },
  { n: '4', title: 'Counting the full cost, from purchase to repair' },
  { n: '5', title: 'Who gets access, and who gets left out' },
  { n: '6', title: 'Questions for funders and public bodies' },
];

const formats = [
  {
    label: 'The Five-Minute Version',
    description: 'The abstract and the section list above cover the argument. Start there if you only have a coffee break.',
    href: LINKS.research.whitePaper,
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    label: 'Argue With a Section',
    description: 'Quote a section number, say where you disagree and what you saw in the field. Comments are filed by section.',
    href: LINKS.research.feedback,
    icon: 'M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z',
  },
];
---

<BaseLayout title="Research" description={`Working Notes on Climate Robots - a fictional white paper from the ${SITE.name}.`}>
  {/* ─── HERO ─── */}
  <section class="relative overflow-hidden bg-vrc-navy text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-vrc-navy via-vrc-blue-dark to-vrc-blue"></div>
    <div class="absolute inset-0 opacity-25" style="background-image: radial-gradient(circle at 20% 30%, rgba(22,163,74,0.35), transparent 50%), radial-gradient(circle at 80% 70%, rgba(59,130,246,0.3), transparent 50%);"></div>

    <div class="relative container mx-auto px-4 py-20 lg:py-28">
      <div class="grid lg:grid-cols-12 gap-12 items-center max-w-7xl mx-auto">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-vrc-green/15 border border-vrc-green/40 rounded-full text-vrc-green text-xs font-semibold uppercase tracking-wider mb-6">
            2026 Edition · Fictional Demo
          </div>
          <h1 class="font-heading font-bold text-5xl md:text-6xl lg:text-7xl leading-[0.95] mb-6">
            Working Notes
            <span class="block text-transparent bg-clip-text bg-gradient-to-r from-vrc-green via-emerald-400 to-teal-300">on Climate Robots</span>
          </h1>
          <p class="text-lg md:text-xl text-white/75 max-w-2xl mb-10 leading-relaxed">
            A short white paper, written as demo content, that asks a simple question: when does sending a robot into the field actually help the climate, and when is it a distraction?
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href={LINKS.research.whitePaper}
              class="inline-flex items-center gap-2 px-6 py-3.5 bg-vrc-green text-white font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-vrc-green-dark transition-colors shadow-lg shadow-vrc-green/25"
            >
              Read the Paper
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a
              href={LINKS.research.feedback}
              class="inline-flex items-center gap-2 px-6 py-3.5 bg-white/10 backdrop-blur-sm border border-white/30 text-white font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-white/20 transition-colors"
            >
              Share Feedback
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative">
            <div class="absolute -inset-4 bg-gradient-to-br from-vrc-green/20 to-vrc-blue/20 rounded-3xl blur-2xl"></div>
            <img
              src="/images/white-paper.svg"
              alt="Illustration of a white paper cover with a tile pattern"
              class="relative w-full rounded-2xl shadow-2xl ring-1 ring-white/10"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── ABSTRACT + CONTENTS ─── */}
  <section id="white-paper" class="py-20 lg:py-28 bg-white scroll-mt-24">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-12 gap-12 items-start max-w-7xl mx-auto">
        <div class="lg:col-span-5">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-vrc-blue mb-3">
            Abstract
          </div>
          <h2 class="font-heading font-bold text-4xl md:text-5xl text-gray-900 mb-6 leading-tight">
            Useful, costly<br/>and easy to<br/>oversell.
          </h2>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            We look at five outdoor jobs where robots are already being tried, from methane surveys to snowpack sensing. For each we ask what the machine replaces, what it needs to keep running and who pays for it.
          </p>
          <p class="text-gray-600 leading-relaxed">
            <strong class="text-gray-900">Our short answer:</strong> robots pay off when the task is repetitive, the site is hard to reach and local teams can repair them. Elsewhere, simpler tools often win.
          </p>
        </div>

        <div class="lg:col-span-7">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400 mb-4">
            Key Themes
          </div>
          <div class="flex flex-wrap gap-2 mb-8">
            {topics.map(t => (
              <span class={`inline-block px-4 py-2 text-sm font-semibold text-white rounded-full bg-gradient-to-r ${t.color} shadow-sm`}>
                {t.label}
              </span>
            ))}
          </div>

          <ol class="space-y-3 mb-8">
            {contents.map(c => (
              <li class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl">
                <span class="w-8 h-8 shrink-0 bg-vrc-blue text-white rounded-lg flex items-center justify-center font-heading font-bold">{c.n}</span>
                <span class="text-gray-800 font-semibold pt-1">{c.title}</span>
              </li>
            ))}
          </ol>

          <div class="rounded-2xl overflow-hidden shadow-2xl ring-1 ring-gray-200">
            <VideoPlaceholder title="Introducing the white paper" caption="A short walkthrough of the paper would go here." />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── FORMATS ─── */}
  <section class="py-20 lg:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-vrc-blue mb-3">
          Two Ways In
        </div>
        <h2 class="font-heading font-bold text-4xl md:text-5xl text-gray-900 mb-4">
          Skim it or push back
        </h2>
        <p class="text-gray-600 text-lg">
          The paper is short on purpose. The useful part is what readers add to it.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {formats.map(f => (
          <a
            href={f.href}
            class="group relative overflow-hidden rounded-2xl bg-white shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 p-8 flex flex-col"
          >
            <div class="w-14 h-14 bg-vrc-blue/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-vrc-blue group-hover:scale-110 transition-all duration-300">
              <svg class="w-7 h-7 text-vrc-blue group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={f.icon}/></svg>
            </div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-2">{f.label}</h3>
            <p class="text-gray-600 mb-6 flex-1">{f.description}</p>
            <span class="inline-flex items-center gap-1 text-vrc-blue font-bold uppercase tracking-wider text-sm group-hover:gap-2 transition-all">
              Open
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ─── FEEDBACK CTA ─── */}
  <section id="feedback" class="py-20 bg-white scroll-mt-24">
    <div class="container mx-auto px-4">
      <div class="relative overflow-hidden bg-gradient-to-br from-vrc-blue to-vrc-blue-dark rounded-3xl max-w-5xl mx-auto p-10 md:p-16">
        <div class="absolute top-0 right-0 w-64 h-64 bg-vrc-green/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/10 rounded-full blur-2xl translate-y-1/2 -translate-x-1/2"></div>

        <div class="relative grid md:grid-cols-2 gap-8 items-center">
          <div>
            <h2 class="font-heading font-bold text-3xl md:text-4xl text-white mb-3 leading-tight">
              Tell us what we got wrong
            </h2>
            <p class="text-white/80 text-lg">
              Email your notes to {LINKS.contact.email} or start a thread in the community workspace. Good comments shape the next draft.
            </p>
          </div>
          <div class="flex md:justify-end">
            <a href={LINKS.contact.mailto} class="inline-flex items-center gap-3 px-8 py-4 bg-white text-vrc-blue font-bold uppercase tracking-wider rounded-lg hover:bg-vrc-green hover:text-white transition-colors shadow-xl">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              Send Feedback
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
