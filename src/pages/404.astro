---
/**
 * The page that isn't there (#38), in the V3 look.
 *
 * It suggests the places people actually want, with no search box: there is
 * nothing to search yet, and a box that finds nothing is worse than a list
 * of real links.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { editionDates, getCurrentEdition } from '@/lib/content';
import type { IconName } from '@/lib/icons';
import { LINKS } from '@/lib/constants';

const edition = getCurrentEdition();
const suggestions: { href: string; title: string; detail: string; icon: IconName }[] = [
  { href: `/summits/${edition.year}`, title: `Summit ${edition.year}`, detail: `${editionDates(edition)} · online · free`, icon: 'calendar' },
  { href: '/watch', title: 'Watch', detail: 'Summit talks, the series and explainers', icon: 'watch' },
  { href: '/research', title: 'Research', detail: 'The white paper and the three codes', icon: 'document' },
  { href: '/map', title: 'The map', detail: 'Organizations building climate robots', icon: 'map-pin' },
  { href: '/news', title: 'News', detail: 'Essays, announcements and episodes', icon: 'news' },
  { href: '/people', title: 'People', detail: 'The team, speakers and authors', icon: 'users' },
];
---

<SiteLayout title="Page not found" noindex>
  <section class="px-4 py-16 lg:px-8 lg:py-24">
    <div class="mx-auto flex max-w-page flex-col gap-10">
      <div class="flex max-w-2xl flex-col gap-5">
        <span class="font-mono text-xs tracking-[0.06em] text-vrc-muted">404 · PAGE NOT FOUND</span>
        <h1 class="m-0 font-heading text-[clamp(44px,7vw,84px)] font-semibold leading-[0.94] tracking-[-0.045em]">
          That page isn’t here
        </h1>
        <p class="m-0 text-xl text-vrc-ink-2">
          It may have moved when we rebuilt the site, or the address may have a typo in it. Here is where most people are
          going.
        </p>
        <div class="flex flex-wrap gap-3">
          <Button href="/">Go to the home page <Icon name="arrow-right" /></Button>
          <Button href={LINKS.contact.mailto} variant="secondary">Tell us what you were looking for</Button>
        </div>
      </div>

      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-3 p-0">
        {
          suggestions.map((s) => (
            <li>
              <a href={s.href} class="flex h-full items-center gap-3.5 rounded-2xl border border-vrc-line p-5 text-vrc-ink no-underline hover:bg-vrc-surface-2 hover:text-vrc-ink">
                <span aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-vrc-blue-tint text-vrc-blue">
                  <Icon name={s.icon} size={20} />
                </span>
                <span class="flex min-w-0 flex-col leading-snug">
                  <strong class="font-semibold">{s.title}</strong>
                  <span class="text-sm text-vrc-muted">{s.detail}</span>
                </span>
                <Icon name="chevron-right" class="ml-auto text-vrc-blue" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</SiteLayout>
