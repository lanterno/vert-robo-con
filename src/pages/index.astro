---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE, LINKS } from '@/lib/constants';
import { SUMMITS, SPEAKERS_2026, getKeynoteSpeakers } from '@/lib/summits-data';

const latestSummit = Object.values(SUMMITS).sort((a, b) => parseInt(b.year) - parseInt(a.year))[0];
const summitsHeld = Object.values(SUMMITS).filter(s => s.status === 'past').length;

const heroSpeakers = [
  ...getKeynoteSpeakers('2026'),
  ...SPEAKERS_2026.filter(s => s.photoUrl && !s.isKeynote).slice(0, 4),
].filter(s => s.photoUrl).slice(0, 6);

const applicationDomains = [
  { label: 'Methane Leak Surveys', color: 'from-amber-500 to-orange-500' },
  { label: 'Peatland Monitoring', color: 'from-emerald-500 to-green-600' },
  { label: 'Street Heat Mapping', color: 'from-red-500 to-rose-600' },
  { label: 'Snowpack Sensing', color: 'from-cyan-500 to-blue-500' },
  { label: 'Greenhouse Automation', color: 'from-violet-500 to-purple-600' },
];
---

<BaseLayout title="Home" description={`${SITE.name} - ${SITE.tagline}. ${SITE.description}`}>
  {/* ─── HERO ─── */}
  <section class="relative overflow-hidden bg-vrc-navy text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-vrc-navy via-vrc-blue-dark to-vrc-blue"></div>
    <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(circle at 25% 25%, rgba(22,163,74,0.3), transparent 45%), radial-gradient(circle at 75% 75%, rgba(59,130,246,0.3), transparent 45%);"></div>

    <div class="relative container mx-auto px-4 py-20 lg:py-28">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-vrc-green/15 border border-vrc-green/40 rounded-full text-vrc-green text-xs font-semibold uppercase tracking-wider mb-6">
            <span class="w-1.5 h-1.5 bg-vrc-green rounded-full animate-pulse"></span>
            {SITE.stats.members} members · {SITE.stats.countries} countries
          </div>
          <h1 class="font-heading font-bold text-5xl md:text-6xl lg:text-7xl leading-[0.95] mb-6">
            Robots for a
            <span class="block text-transparent bg-clip-text bg-gradient-to-r from-vrc-green via-emerald-400 to-teal-300">Cooler Planet.</span>
          </h1>
          <p class="text-lg md:text-xl text-white/75 max-w-2xl mb-10 leading-relaxed">
            {SITE.name} is a fictional meeting place for people who design, test and deploy machines that help with climate work. Swap notes, find collaborators and learn what works in the field — and what does not.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/slack"
              class="inline-flex items-center gap-2 px-6 py-3.5 bg-vrc-green text-white font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-vrc-green-dark transition-colors shadow-lg shadow-vrc-green/25"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              Join the Community
            </a>
            <a
              href="/summits"
              class="inline-flex items-center gap-2 px-6 py-3.5 bg-white/10 backdrop-blur-sm border border-white/30 text-white font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-white/20 transition-colors"
            >
              Explore the Summits
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative">
            <div class="absolute -inset-4 bg-gradient-to-br from-vrc-green/20 to-vrc-blue/20 rounded-3xl blur-2xl"></div>
            <img
              src="/images/hero.svg"
              alt="Illustration of a small robot planting a sapling on a green hill"
              class="relative w-full rounded-2xl shadow-2xl ring-1 ring-white/10"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── WHAT WE DO ─── */}
  <section class="py-20 lg:py-28 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-12 gap-12 items-start max-w-7xl mx-auto">
        <div class="lg:col-span-5">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-vrc-blue mb-3">
            Why We Exist
          </div>
          <h2 class="font-heading font-bold text-4xl md:text-5xl text-gray-900 mb-6 leading-tight">
            Fewer surprises<br/>in the field.
          </h2>
          <p class="text-lg text-gray-600 mb-6 leading-relaxed">
            Most climate robots are built by small teams who rarely meet the people who will <strong class="text-gray-900">repair, insure, buy or regulate</strong> them. We put those groups in the same conversation, so weak spots show up before a machine ships rather than after.
          </p>
          <p class="text-gray-600 mb-8 leading-relaxed">
            A technician's complaint about a hidden fuse box is worth as much here as a founder's demo video.
          </p>
          <a href="/research" class="inline-flex items-center gap-2 text-vrc-blue font-bold uppercase tracking-wider text-sm hover:underline">
            Read the White Paper
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <div class="lg:col-span-7">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400 mb-4">
            Topics Members Raised This Year
          </div>
          <div class="flex flex-wrap gap-2 mb-6">
            {applicationDomains.map(domain => (
              <span class={`inline-block px-4 py-2 text-sm font-semibold text-white rounded-full bg-gradient-to-r ${domain.color} shadow-sm`}>
                {domain.label}
              </span>
            ))}
          </div>
          <p class="text-gray-500 italic">
            Each chip is a theme that came up on member calls. The projects behind them, like everything on this site, are invented.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ─── LATEST SUMMIT SPOTLIGHT ─── */}
  {latestSummit && (
    <section class="py-20 lg:py-28 bg-gray-900 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-25" style="background-image: radial-gradient(circle at 30% 50%, rgba(22,163,74,0.4), transparent 50%), radial-gradient(circle at 80% 80%, rgba(59,130,246,0.4), transparent 50%);"></div>

      <div class="relative container mx-auto px-4">
        <div class="grid lg:grid-cols-12 gap-12 items-center max-w-7xl mx-auto">
          <div class="lg:col-span-7 order-2 lg:order-1">
            <div class="grid grid-cols-3 gap-3">
              {heroSpeakers.map((s, i) => (
                <div class={`aspect-square rounded-2xl overflow-hidden ring-1 ring-white/10 shadow-xl ${i === 1 ? 'translate-y-6' : ''} ${i === 4 ? '-translate-y-6' : ''}`}>
                  <img src={s.photoUrl} alt={s.name} class="w-full h-full object-cover" loading="lazy" />
                </div>
              ))}
            </div>
          </div>

          <div class="lg:col-span-5 order-1 lg:order-2">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-vrc-green mb-3">
              {latestSummit.status === 'upcoming' ? 'Coming Up' : 'Most Recent'}
            </div>
            <h2 class="font-heading font-bold text-4xl md:text-5xl mb-4 leading-tight">
              Vert Robo Con<br/>Summit {latestSummit.year}
            </h2>
            <p class="text-white/70 mb-2">{latestSummit.dates} · {latestSummit.location}</p>
            <p class="text-white/70 mb-8 leading-relaxed">
              {latestSummit.description}
            </p>
            <a
              href={`/summits/${latestSummit.year}`}
              class="inline-flex items-center gap-2 px-6 py-3 bg-white text-gray-900 font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-vrc-green hover:text-white transition-colors"
            >
              Explore Summit {latestSummit.year}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* ─── WHITE PAPER + MAP — TWO-CARD FEATURE ─── */}
  <section class="py-20 lg:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-6 max-w-6xl mx-auto">
        {/* White Paper card */}
        <a href="/research" class="group relative overflow-hidden rounded-2xl bg-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 p-8 md:p-10 flex flex-col">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-vrc-blue mb-3">
            2026 Research
          </div>
          <h3 class="font-heading font-bold text-2xl md:text-3xl text-gray-900 mb-3 leading-tight">
            Working Notes on Climate Robots
          </h3>
          <p class="text-gray-600 mb-6 leading-relaxed">
            A short, fictional white paper on what field robots can and cannot do for climate work, written as demo content for this site.
          </p>
          <div class="aspect-video rounded-xl overflow-hidden bg-gray-100 mb-6 mt-auto">
            <img src="/images/white-paper.svg" alt="Illustration of a white paper cover" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
          </div>
          <span class="inline-flex items-center gap-1 text-vrc-blue font-bold uppercase tracking-wider text-sm group-hover:gap-2 transition-all">
            Read White Paper
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </span>
        </a>

        {/* Map card */}
        <a href="/map" class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-vrc-blue to-vrc-blue-dark text-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 p-8 md:p-10 flex flex-col">
          <div class="absolute top-0 right-0 w-64 h-64 bg-vrc-green/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
          <div class="relative">
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-vrc-green mb-3">
              The Global Map
            </div>
            <h3 class="font-heading font-bold text-2xl md:text-3xl mb-3 leading-tight">
              120 fictional organisations across 18 countries
            </h3>
            <p class="text-white/75 mb-6 leading-relaxed">
              Every pin is a made-up team placed in a real city. Open one to read its profile, or download the whole dataset as JSON.
            </p>
            <div class="aspect-video rounded-xl overflow-hidden bg-white/10 mb-6 mt-auto ring-1 ring-white/10">
              <img src="/images/global-map.svg" alt="Abstract map illustration with location pins" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-300" loading="lazy" />
            </div>
            <span class="inline-flex items-center gap-1 text-white font-bold uppercase tracking-wider text-sm group-hover:gap-2 transition-all">
              Open the Map
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* ─── IMPACT NUMBERS ─── */}
  <section class="py-20 bg-vrc-navy text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-vrc-navy via-vrc-blue-dark to-vrc-navy"></div>
    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 30% 30%, rgba(22,163,74,0.3), transparent 50%), radial-gradient(circle at 70% 70%, rgba(59,130,246,0.3), transparent 50%);"></div>
    <div class="relative container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-5xl mx-auto">
        <div class="text-center">
          <div class="font-heading font-bold text-5xl md:text-6xl text-vrc-green mb-2 tabular-nums">{SITE.stats.members}</div>
          <div class="text-sm uppercase tracking-wider text-white/60">Members</div>
        </div>
        <div class="text-center">
          <div class="font-heading font-bold text-5xl md:text-6xl text-vrc-green mb-2 tabular-nums">{SITE.stats.countries}</div>
          <div class="text-sm uppercase tracking-wider text-white/60">Countries</div>
        </div>
        <div class="text-center">
          <div class="font-heading font-bold text-5xl md:text-6xl text-vrc-green mb-2 tabular-nums">{SITE.stats.sectors}</div>
          <div class="text-sm uppercase tracking-wider text-white/60">Sectors</div>
        </div>
        <div class="text-center">
          <div class="font-heading font-bold text-5xl md:text-6xl text-vrc-green mb-2 tabular-nums">{summitsHeld}</div>
          <div class="text-sm uppercase tracking-wider text-white/60">Summits Held</div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── COMMUNITY CTA ─── */}
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="relative overflow-hidden bg-gradient-to-br from-vrc-blue to-vrc-blue-dark rounded-3xl max-w-5xl mx-auto p-10 md:p-16">
        <div class="absolute top-0 right-0 w-64 h-64 bg-vrc-green/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/10 rounded-full blur-2xl translate-y-1/2 -translate-x-1/2"></div>

        <div class="relative grid md:grid-cols-2 gap-8 items-center">
          <div>
            <h2 class="font-heading font-bold text-3xl md:text-4xl text-white mb-3 leading-tight">
              Want to pitch in?
            </h2>
            <p class="text-white/80 text-lg">
              {SITE.stats.members} members already trade ideas in our community workspace. Say hello, ask a question, share what you are building.
            </p>
          </div>
          <div class="flex md:justify-end">
            <a href="/slack" class="inline-flex items-center gap-3 px-8 py-4 bg-white text-vrc-blue font-bold uppercase tracking-wider rounded-lg hover:bg-vrc-green hover:text-white transition-colors shadow-xl">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              Join the Community
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
