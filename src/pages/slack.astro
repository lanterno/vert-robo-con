---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LINKS, SITE } from '@/lib/constants';

const chatIcon = 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z';

const criteria = [
  {
    n: '#field-notes',
    title: 'Show Your Data',
    description: 'Photos, logs and numbers from real deployments, including the ones that went badly.',
  },
  {
    n: '#help-desk',
    title: 'Ask Specific Questions',
    description: 'Say what you tried, what happened and what you expected. You will get better answers faster.',
  },
  {
    n: '#jobs-and-calls',
    title: 'Post Openings Here Only',
    description: 'Jobs, calls for papers and pilot partners go in one place, so other channels stay readable.',
  },
  {
    n: '#weekly-thread',
    title: 'Reply in Threads',
    description: 'One topic, one thread. People in other time zones can catch up without scrolling for an hour.',
  },
];

const conduct = [
  'Treat everyone with respect. Harassment, insults and discrimination of any kind are not allowed.',
  'Ask before you share someone else\'s work, photo or message outside the workspace.',
  'No unsolicited direct messages for sales, recruiting or fundraising.',
  'Disagree with ideas, not with people. Back up claims with sources or first-hand experience.',
  'Keep private details private: do not post personal contact information without consent.',
  'If something feels wrong, tell a moderator at ' + LINKS.contact.email + '. Reports are handled in confidence.',
];
---

<BaseLayout title="Join the Community" description={`Join the ${SITE.name} community workspace - ${SITE.stats.members} members across ${SITE.stats.countries} countries. Fictional demo content.`}>
  {/* ─── HERO ─── */}
  <section class="relative overflow-hidden text-white min-h-[60vh] flex items-center">
    <div class="absolute inset-0">
      <img src="/images/community.svg" alt="Abstract illustration of connected circles" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-br from-vrc-navy/85 via-vrc-navy/65 to-transparent"></div>
    </div>

    <div class="relative container mx-auto px-4 py-20">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-vrc-green/15 border border-vrc-green/40 rounded-full text-vrc-green text-xs font-semibold uppercase tracking-wider mb-6">
          <span class="w-1.5 h-1.5 bg-vrc-green rounded-full animate-pulse"></span>
          {SITE.stats.members} members · {SITE.stats.countries} countries
        </div>
        <h1 class="font-heading font-bold text-5xl md:text-6xl lg:text-7xl leading-[0.95] mb-6">
          Come Build
          <span class="block text-transparent bg-clip-text bg-gradient-to-r from-vrc-green via-emerald-400 to-teal-300">With Us.</span>
        </h1>
        <p class="text-lg md:text-xl text-white/80 max-w-2xl mb-10 leading-relaxed">
          Our community workspace is where members swap field notes, ask for help with a stubborn prototype and find people to build with. Everyone is welcome, from first-year students to seasoned operators.
        </p>
        <a
          href={LINKS.community.join}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-3 px-8 py-4 bg-vrc-green text-white font-bold uppercase tracking-wider rounded-lg hover:bg-vrc-green-dark transition-colors shadow-xl shadow-vrc-green/30"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={chatIcon}/></svg>
          Join the Workspace
        </a>
      </div>
    </div>
  </section>

  {/* ─── STARTER CHANNELS ─── */}
  <section class="py-20 lg:py-28 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-vrc-blue mb-3">
          Finding Your Way Around
        </div>
        <h2 class="font-heading font-bold text-4xl md:text-5xl text-gray-900 mb-4 leading-tight">
          Four channels to start with
        </h2>
        <p class="text-gray-600 text-lg">
          The workspace has more, but these are where most useful conversations begin.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {criteria.map(c => (
          <div class="relative p-8 bg-gray-50 rounded-2xl hover:bg-white hover:shadow-2xl transition-all duration-300 border border-transparent hover:border-gray-100">
            <div class="inline-flex px-3 h-10 bg-gradient-to-br from-vrc-blue to-vrc-blue-dark text-white rounded-xl items-center justify-center font-mono font-semibold text-sm mb-6 shadow-lg">
              {c.n}
            </div>
            <h3 class="font-heading font-bold text-2xl text-gray-900 mb-3">{c.title}</h3>
            <p class="text-gray-600 leading-relaxed">{c.description}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  {/* ─── CODE OF CONDUCT + JOIN — split card ─── */}
  <section class="py-20 lg:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {/* CoC */}
        <a
          href={LINKS.community.codeOfConduct}
          class="group relative overflow-hidden rounded-2xl bg-white shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 p-8 md:p-10 flex flex-col"
        >
          <div class="w-14 h-14 bg-vrc-blue/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-vrc-blue group-hover:scale-110 transition-all duration-300">
            <svg class="w-7 h-7 text-vrc-blue group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
          </div>
          <h3 class="font-heading font-bold text-2xl text-gray-900 mb-3">Read the Code of Conduct</h3>
          <p class="text-gray-600 mb-6 flex-1">
            Six short rules, written by us, that apply in every channel and every event. It takes two minutes to read.
          </p>
          <span class="inline-flex items-center gap-1 text-vrc-blue font-bold uppercase tracking-wider text-sm group-hover:gap-2 transition-all">
            Read the Rules
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
          </span>
        </a>

        {/* Join */}
        <a
          href={LINKS.community.join}
          target="_blank"
          rel="noopener"
          class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-vrc-blue to-vrc-blue-dark text-white shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 p-8 md:p-10 flex flex-col"
        >
          <div class="absolute top-0 right-0 w-48 h-48 bg-vrc-green/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
          <div class="relative flex-1 flex flex-col">
            <div class="w-14 h-14 bg-white/15 rounded-xl flex items-center justify-center mb-6 group-hover:bg-white group-hover:scale-110 transition-all duration-300">
              <svg class="w-7 h-7 text-white group-hover:text-vrc-blue transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={chatIcon}/></svg>
            </div>
            <h3 class="font-heading font-bold text-2xl mb-3">Request an Invite</h3>
            <p class="text-white/80 mb-6 flex-1">
              Fill in a short form and a moderator will send your invite. Once inside, say hello in #introductions.
            </p>
            <span class="inline-flex items-center gap-1 text-white font-bold uppercase tracking-wider text-sm group-hover:gap-2 transition-all">
              Join the Workspace
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* ─── CODE OF CONDUCT (full text) ─── */}
  <section id="code-of-conduct" class="py-20 lg:py-24 bg-white scroll-mt-24">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-vrc-blue mb-3">
          Code of Conduct
        </div>
        <h2 class="font-heading font-bold text-4xl md:text-5xl text-gray-900 mb-6 leading-tight">
          The rules of the room
        </h2>
        <p class="text-gray-600 text-lg mb-8">
          These rules cover the workspace, our summits and any other space run by the {SITE.name}. Moderators may remove messages or members who break them.
        </p>
        <ol class="space-y-4">
          {conduct.map((rule, i) => (
            <li class="flex items-start gap-4 p-5 bg-gray-50 rounded-xl">
              <span class="w-8 h-8 shrink-0 bg-vrc-blue text-white rounded-lg flex items-center justify-center font-heading font-bold">{i + 1}</span>
              <span class="text-gray-700 leading-relaxed pt-1">{rule}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>
