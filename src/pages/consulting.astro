---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LINKS, SITE } from '@/lib/constants';

const services = [
  {
    icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
    title: 'Site Readiness Check',
    description: 'Before anything is bought, we walk through the site with you on a video call and list what could stop a robot there: power, signal, weather, access and who is around.',
  },
  {
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
    title: 'Robot Shortlist',
    description: 'We turn your requirements into a scored comparison of machines you can actually buy or rent, including what each one costs to keep running for five years.',
  },
  {
    icon: 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4',
    title: 'Data Handover Plan',
    description: 'An agreement, written before the pilot starts, on what the robot records, who owns it and where it lives once the trial is over.',
  },
  {
    icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
    title: 'Post-Pilot Review',
    description: 'We read the logs, talk to the crew and give you a plain recommendation: scale it, change it or stop.',
  },
];

const situations = [
  'Writing your first robot tender',
  'A pilot that stalled after one season',
  'Two vendors, one budget',
  'Handing field data to a public archive',
  'Explaining results to a board',
  'Planning a second site',
];

const engagementTypes = [
  { amount: '5 pages', label: 'Desk Memo', description: 'We read what you send and reply in writing. No meetings needed.' },
  { amount: '2 calls', label: 'Working Pair', description: 'A member with the right field experience works through the problem with you.' },
  { amount: '3 checkpoints', label: 'Pilot Companion', description: 'A review before, during and after your trial, each with written notes.' },
];
---

<BaseLayout title="Consulting" description="Fictional consulting from the Example Robotics Network: site checks, robot shortlists, data plans and pilot reviews. Demo content.">
  {/* ─── HERO ─── */}
  <section class="relative overflow-hidden bg-vrc-navy text-white min-h-[70vh] flex items-center">
    <div class="absolute inset-0">
      <img src="/images/consulting.svg" alt="Abstract illustration of a forest with light beams" class="w-full h-full object-cover opacity-40" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-br from-vrc-navy via-vrc-navy/85 to-vrc-navy/50"></div>
      <div class="absolute inset-0 opacity-25" style="background-image: radial-gradient(circle at 20% 30%, rgba(22,163,74,0.35), transparent 50%);"></div>
    </div>

    <div class="relative container mx-auto px-4 py-20">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-vrc-green/15 border border-vrc-green/40 rounded-full text-vrc-green text-xs font-semibold uppercase tracking-wider mb-6">
          Consulting · Demo Service
        </div>
        <h1 class="font-heading font-bold text-5xl md:text-6xl lg:text-7xl leading-[0.95] mb-6">
          Ask Before
          <span class="block text-transparent bg-clip-text bg-gradient-to-r from-vrc-green via-emerald-400 to-teal-300">You Buy.</span>
        </h1>
        <p class="text-lg md:text-xl text-white/80 max-w-2xl mb-10 leading-relaxed">
          Most robot pilots that disappoint go wrong in the first month, long before the hardware fails. This (fictional) service helps you catch the obvious problems while they are still cheap to fix.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#contact" class="inline-flex items-center gap-2 px-6 py-3.5 bg-vrc-green text-white font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-vrc-green-dark transition-colors shadow-lg shadow-vrc-green/25">
            Get in Touch
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="#services" class="inline-flex items-center gap-2 px-6 py-3.5 bg-white/10 backdrop-blur-sm border border-white/30 text-white font-bold uppercase tracking-wider text-sm rounded-lg hover:bg-white/20 transition-colors">
            Our Services
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ─── SERVICES GRID ─── */}
  <section id="services" class="py-20 lg:py-28 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-vrc-blue mb-3">
          Our Services
        </div>
        <h2 class="font-heading font-bold text-4xl md:text-5xl text-gray-900 mb-4">
          Four pieces of work
        </h2>
        <p class="text-gray-600 text-lg">
          Each one ends with a written document you keep, whether or not you go ahead.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {services.map(service => (
          <div class="group p-8 bg-gray-50 rounded-2xl hover:bg-white hover:shadow-2xl transition-all duration-300 border border-transparent hover:border-gray-100">
            <div class="w-14 h-14 bg-vrc-blue/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-vrc-blue group-hover:scale-110 transition-all duration-300">
              <svg class="w-7 h-7 text-vrc-blue group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon}/></svg>
            </div>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-3">{service.title}</h3>
            <p class="text-gray-600 leading-relaxed">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ─── ENGAGEMENT MODELS ─── */}
  <section class="py-20 lg:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-vrc-blue mb-3">
          Formats
        </div>
        <h2 class="font-heading font-bold text-4xl md:text-5xl text-gray-900 mb-4">
          Measured in output, not hours
        </h2>
        <p class="text-gray-600 text-lg">
          We agree on what you will receive, then on the price.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-4 max-w-4xl mx-auto">
        {engagementTypes.map(type => (
          <div class="p-6 bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow text-center">
            <div class="font-heading font-bold text-3xl text-vrc-blue mb-2 tabular-nums">{type.amount}</div>
            <div class="font-semibold text-gray-900 mb-2">{type.label}</div>
            <p class="text-gray-500 text-sm">{type.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ─── SITUATIONS + COORDINATOR — asymmetric ─── */}
  <section class="py-20 lg:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-12 gap-12 items-start max-w-7xl mx-auto">
        {/* Coordinator — left, with avatar */}
        <div class="lg:col-span-5">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-vrc-blue mb-3">
            Who Answers
          </div>
          <div class="relative mb-6">
            <div class="absolute -inset-2 bg-gradient-to-br from-vrc-green/20 to-vrc-blue/20 rounded-3xl blur-xl"></div>
            <img
              src="/images/people/imogen-calder.svg"
              alt="Initials avatar for Imogen Calder"
              class="relative w-full max-w-xs rounded-2xl shadow-2xl ring-1 ring-gray-200"
              loading="lazy"
            />
          </div>
          <h3 class="font-heading font-bold text-3xl text-gray-900 mb-2">Imogen Calder</h3>
          <p class="text-vrc-blue font-semibold mb-4">Consulting Coordinator · {SITE.name}</p>
          <p class="text-gray-600 leading-relaxed mb-4">
            Imogen reads every request first. She likes tender documents, maintenance logs and data licences, the paperwork most people skip, and she matches each request with members who have done that kind of work. Imogen is an invented character for this demo.
          </p>
          <a
            href={LINKS.contact.mailto}
            class="inline-flex items-center gap-2 text-vrc-blue font-bold uppercase tracking-wider text-sm hover:underline"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Email {LINKS.contact.email}
          </a>
        </div>

        {/* Situations — right */}
        <div class="lg:col-span-7">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-vrc-blue mb-3">
            Typical Requests
          </div>
          <h3 class="font-heading font-bold text-3xl md:text-4xl text-gray-900 mb-6 leading-tight">
            Bring us a situation, not a sector
          </h3>
          <p class="text-gray-600 leading-relaxed mb-8">
            Requests usually start with one of these. If yours is different, describe it in a few lines and we will tell you honestly whether we can help.
          </p>
          <div class="flex flex-wrap gap-2">
            {situations.map(type => (
              <span class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full font-semibold text-sm hover:bg-vrc-blue hover:text-white transition-colors cursor-default">
                {type}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── CONTACT CTA ─── */}
  <section id="contact" class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="relative overflow-hidden bg-gradient-to-br from-vrc-blue to-vrc-blue-dark rounded-3xl max-w-5xl mx-auto p-10 md:p-16">
        <div class="absolute top-0 right-0 w-64 h-64 bg-vrc-green/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/10 rounded-full blur-2xl translate-y-1/2 -translate-x-1/2"></div>

        <div class="relative text-center max-w-2xl mx-auto mb-10">
          <h2 class="font-heading font-bold text-3xl md:text-4xl text-white mb-3 leading-tight">
            Tell us what you are weighing up
          </h2>
          <p class="text-white/80 text-lg">
            A paragraph is enough: the site, the robot if you have one, and your deadline.
          </p>
        </div>

        <div class="relative grid sm:grid-cols-2 gap-4 max-w-xl mx-auto">
          <a href={LINKS.contact.mailto} class="group flex flex-col items-center p-6 bg-white/10 backdrop-blur-sm rounded-2xl hover:bg-white/20 transition-colors border border-white/10">
            <svg class="w-10 h-10 text-white mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span class="text-white font-bold uppercase tracking-wider text-sm">Email Us</span>
            <span class="text-white/60 text-xs mt-1">{LINKS.contact.email}</span>
          </a>
          <a href={LINKS.community.join} target="_blank" rel="noopener" class="group flex flex-col items-center p-6 bg-white/10 backdrop-blur-sm rounded-2xl hover:bg-white/20 transition-colors border border-white/10">
            <svg class="w-10 h-10 text-white mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            <span class="text-white font-bold uppercase tracking-wider text-sm">Ask the Community</span>
            <span class="text-white/60 text-xs mt-1">Post in #consulting</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
