---
/**
 * VideoCard Component
 * Shows a recording slot with a placeholder thumbnail, title, duration and play
 * button. Clicking it opens the shared recording modal, which the page renders
 * once with <VideoModal />. The site has no real videos.
 */
import type { Video } from '@/lib/summits-data';

interface Props {
  video: Video;
  compact?: boolean;
}

const { video, compact = false } = Astro.props;

const typeColors = {
  keynote: 'bg-purple-500',
  panel: 'bg-vrc-blue',
  talk: 'bg-teal-500',
  pitch: 'bg-orange-500',
  opening: 'bg-vrc-green',
  closing: 'bg-gray-600',
};

const typeLabels = {
  keynote: 'Keynote',
  panel: 'Panel',
  talk: 'Talk',
  pitch: 'Pitches',
  opening: 'Opening',
  closing: 'Closing',
};
---

<div
  class={`video-card group relative bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 cursor-pointer ${compact ? '' : 'hover:-translate-y-1'}`}
  data-video-title={video.title}
  role="button"
  tabindex="0"
  aria-label={`Open recording placeholder: ${video.title}`}
>
  {/* Placeholder thumbnail */}
  <div class="relative aspect-video">
    <div class="w-full h-full bg-gray-200 flex items-end justify-start p-3" aria-hidden="true">
      <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-gray-500">Recording placeholder</span>
    </div>

    {/* Play Button Overlay */}
    <div class="absolute inset-0 bg-black/10 group-hover:bg-black/25 transition-colors flex items-center justify-center">
      <div class="w-16 h-16 rounded-full bg-white/90 group-hover:bg-white group-hover:scale-110 transition-all flex items-center justify-center shadow-lg">
        <svg class="w-8 h-8 text-vrc-blue ml-1" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
      </div>
    </div>

    {/* Duration Badge */}
    <div class="absolute bottom-2 right-2 px-2 py-1 bg-black/80 text-white text-xs font-mono rounded">
      {video.duration}
    </div>

    {/* Type Badge */}
    <div class={`absolute top-2 left-2 px-2 py-1 ${typeColors[video.type]} text-white text-xs font-bold uppercase tracking-wide rounded`}>
      {typeLabels[video.type]}
    </div>
  </div>

  {/* Content */}
  <div class={`${compact ? 'p-3' : 'p-4'}`}>
    <h4 class={`font-heading font-semibold text-gray-900 ${compact ? 'text-sm line-clamp-2' : 'text-base line-clamp-2'} group-hover:text-vrc-blue transition-colors`}>
      {video.title}
    </h4>

    {!compact && video.description && (
      <p class="text-gray-600 text-sm mt-2 line-clamp-2">
        {video.description}
      </p>
    )}

    {!compact && video.speakers && video.speakers.length > 0 && (
      <div class="mt-3 flex items-center gap-2 text-sm text-gray-500">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span>{video.speakers.join(', ')}</span>
      </div>
    )}
  </div>
</div>
