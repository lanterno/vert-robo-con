---
/**
 * VideoModal Component
 * The single recording modal for a page. Render it once on any page that shows
 * VideoCard components; it opens for every .video-card on the page and shows a
 * placeholder, because the site has no real videos.
 */
import VideoPlaceholder from './VideoPlaceholder.astro';
---

{/* Recording Modal */}
<div id="video-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/90">
  <div class="relative w-full max-w-5xl">
    {/* Close Button */}
    <button
      id="close-modal"
      class="absolute -top-12 right-0 text-white hover:text-gray-300 transition-colors"
      aria-label="Close recording placeholder"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    {/* Placeholder instead of a video player */}
    <VideoPlaceholder
      title="Vert Robo Con Summit"
      caption="Demo content: no real recording exists for this session."
    />

    {/* Recording Title */}
    <h3 id="modal-title" class="text-white font-heading font-semibold text-xl mt-4"></h3>
  </div>
</div>

<script>
  // Recording modal functionality
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('video-modal');
    const modalTitle = document.getElementById('modal-title');
    const closeBtn = document.getElementById('close-modal');

    // Open modal on card click, Enter or Space
    document.querySelectorAll('.video-card').forEach(card => {
      const open = () => {
        const title = card.getAttribute('data-video-title');

        if (modal && modalTitle) {
          modalTitle.textContent = title || '';
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }
      };
      card.addEventListener('click', open);
      card.addEventListener('keydown', (e) => {
        const key = (e as KeyboardEvent).key;
        if (key === 'Enter' || key === ' ') {
          e.preventDefault();
          open();
        }
      });
    });

    // Close modal
    const closeModal = () => {
      if (modal && !modal.classList.contains('hidden')) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      }
    };

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  });
</script>
