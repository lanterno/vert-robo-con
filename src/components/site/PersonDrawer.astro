---
/**
 * The person drawer from PeopleV3 and SummitV3: a profile in a sheet, with
 * previous and next, the person's tags and bio, where they appear, their
 * links and a link to their page.
 *
 * Give it the people in the order previous and next should follow, and open
 * it from a link to `/people/<slug>` with `data-person-open={slug}`; add
 * `data-person-drawer={id}` when a page has more than one drawer.
 */
import Sheet from '@/components/ui/Sheet.astro';
import Chip from '@/components/ui/Chip.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/icons';
import { initials } from '@/lib/content';

export interface DrawerPerson {
  slug: string;
  name: string;
  /** Role and organisation, on one line. */
  roleLine: string;
  photo?: string;
  tags?: string[];
  bio: string;
  appears?: { title: string; meta: string; href: string; kind: 'session' | 'video' | 'document' | 'post' | 'team' }[];
  links?: { label: string; href: string }[];
}

interface Props {
  people: DrawerPerson[];
  id?: string;
  /** Shown before the position, such as "TEAM" in "TEAM · 3 OF 12". */
  context?: string;
}

const { people, id = 'person-drawer', context = '' } = Astro.props;
const nameId = `${id}-name`;

const KIND_ICON: Record<NonNullable<DrawerPerson['appears']>[number]['kind'], IconName> = {
  session: 'calendar',
  video: 'play',
  document: 'document',
  post: 'news',
  team: 'users',
};

const navBtn =
  'flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl border border-vrc-line-strong bg-white text-vrc-ink hover:bg-vrc-surface-2 aria-disabled:cursor-default aria-disabled:border-vrc-line aria-disabled:text-vrc-disabled aria-disabled:hover:bg-white';
---

<Sheet id={id} labelledby={nameId} data-person-drawer data-context={context}>
  <span slot="lead" data-person-pos class="font-mono text-[11px] tracking-[0.06em] text-vrc-muted"></span>
  <Fragment slot="header">
    <button type="button" data-person-prev class={navBtn} aria-label="Previous"><Icon name="chevron-left" size={18} /></button>
    <button type="button" data-person-next class={navBtn} aria-label="Next"><Icon name="chevron-right" size={18} /></button>
  </Fragment>
  <div data-person-body class="flex flex-col gap-6"></div>
  <!-- One profile per person, copied into the body when it opens. -->
  {
    people.map((p) => (
      <template data-person={p.slug} data-name={p.name}>
        <div class="flex items-center gap-4">
          {p.photo ? (
            <img src={p.photo} alt="" width="88" height="88" class="h-[88px] w-[88px] shrink-0 rounded-[20px] bg-vrc-blue-tint object-cover" />
          ) : (
            <span aria-hidden="true" class="flex h-[88px] w-[88px] shrink-0 items-center justify-center rounded-[20px] bg-vrc-blue-tint font-mono text-[26px] text-vrc-blue">
              {initials(p.name)}
            </span>
          )}
          <div class="flex min-w-0 flex-col gap-1">
            <h2 id={nameId} class="m-0 font-heading text-[26px] font-semibold leading-tight tracking-[-0.02em]">{p.name}</h2>
            <span class="text-[15px] leading-snug text-vrc-ink-2">{p.roleLine}</span>
          </div>
        </div>

        {p.tags && p.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {p.tags.map((t) => <Chip>{t}</Chip>)}
          </div>
        )}

        <p class="m-0 text-base text-vrc-ink-2">{p.bio}</p>

        {p.appears && p.appears.length > 0 && (
          <div class="flex flex-col gap-2">
            <span class="font-mono text-[11px] tracking-[0.06em] text-vrc-muted">APPEARS IN</span>
            <ul class="m-0 flex list-none flex-col gap-2 p-0">
              {p.appears.map((a) => (
                <li>
                  <a href={a.href} class="flex items-center gap-3 rounded-[14px] border border-vrc-line px-3.5 py-3 text-vrc-ink no-underline hover:bg-vrc-surface-2 hover:text-vrc-ink">
                    <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] bg-vrc-blue-tint text-vrc-blue">
                      <Icon name={KIND_ICON[a.kind]} size={a.kind === 'video' ? 14 : 16} filled={a.kind === 'video'} />
                    </span>
                    <span class="flex min-w-0 flex-1 flex-col leading-snug">
                      <strong class="text-[15px] font-medium">{a.title}</strong>
                      <span class="font-mono text-[11px] tracking-[0.02em] text-vrc-muted">{a.meta}</span>
                    </span>
                    <Icon name="chevron-right" class="text-vrc-blue" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="flex flex-wrap items-center gap-x-[18px] gap-y-1 text-[15px] font-medium">
          {p.links && p.links.length > 0 ? (
            p.links.map((l) => (
              <a href={l.href} class="inline-flex min-h-11 items-center gap-1.5">
                {l.label}
                <Icon name="arrow-up-right" size={14} />
              </a>
            ))
          ) : (
            <span class="inline-flex min-h-11 items-center font-normal text-vrc-muted">No public links yet</span>
          )}
          <button type="button" data-person-copy class="inline-flex min-h-11 cursor-pointer items-center gap-1.5 border-0 bg-transparent p-0 font-[inherit] font-medium text-vrc-blue hover:text-vrc-blue-dark">
            <Icon name="link" size={15} />
            Copy link
          </button>
        </div>
        <span data-person-url aria-live="polite" class="-mt-3 break-all font-mono text-xs text-vrc-muted">/people/{p.slug}</span>

        <p class="m-0 border-t border-vrc-line pt-4 text-sm text-vrc-muted">
          Something wrong or missing in this profile? <a href="/contact">Ask for a correction</a>
        </p>
      </template>
    ))
  }
</Sheet>

<script>
  import { initPersonDrawers } from '@/scripts/person-drawer';
  initPersonDrawers();
</script>
