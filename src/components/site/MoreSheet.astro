---
/**
 * The phone tab bar's "More" sheet, with the More tab's list from PhoneV3:
 * the parts of the site that have no tab of their own.
 */
import { MORE, MORE_SHEET, JOIN_SHEET } from '@/lib/site-nav';
import Sheet from '@/components/ui/Sheet.astro';
import Icon from '@/components/ui/Icon.astro';
import NavLinkItem from './NavLinkItem.astro';

const social = 'flex h-11 w-11 items-center justify-center rounded-[10px] text-vrc-muted hover:bg-vrc-surface hover:text-vrc-ink';
---

<Sheet id={MORE_SHEET} title="More">
  <ul class="m-0 list-none overflow-hidden rounded-[20px] border border-vrc-line p-0">
    {
      MORE.map((m, i) => (
        <li class:list={[i > 0 && 'border-t border-vrc-line']}>
          <NavLinkItem
            link={m}
            class="flex min-h-16 w-full items-center gap-3.5 px-3.5 py-3 text-vrc-ink no-underline hover:bg-vrc-surface-2 hover:text-vrc-ink"
          >
            {m.icon && (
              <span aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-vrc-surface">
                <Icon name={m.icon} size={20} />
              </span>
            )}
            <span class="flex min-w-0 flex-1 flex-col">
              <span class="flex flex-wrap items-center gap-2 font-semibold text-vrc-ink">{m.label}</span>
              {m.desc && <span class="text-[13px] leading-snug text-vrc-muted">{m.desc}</span>}
            </span>
          </NavLinkItem>
        </li>
      ))
    }
  </ul>

  <div class="flex flex-col gap-2.5 rounded-[20px] bg-vrc-surface p-[18px]">
    <span class="font-mono text-xs tracking-[0.06em] text-vrc-muted">MONTHLY DIGEST</span>
    <p class="m-0 text-[15px] text-vrc-ink-2">One email a month: summit news, new videos, jobs and map additions.</p>
    <span class="inline-flex items-center gap-2 rounded-full bg-white px-2.5 py-1 font-mono text-[11px] font-medium uppercase tracking-[0.06em] text-vrc-ink-2 self-start">Coming soon</span>
  </div>

  <div class="flex items-center gap-1">
    <a href="https://vert-robo-con.example/social/linkedin" aria-label="LinkedIn" class={social}><Icon name="linkedin" size={18} /></a>
    <a href="/watch" aria-label="Videos" class={social}><Icon name="video" size={18} /></a>
    <a href="mailto:hello@vert-robo-con.example" aria-label="Email hello@vert-robo-con.example" class={social}><Icon name="mail" size={18} /></a>
    <button type="button" data-sheet-open={JOIN_SHEET} aria-label="Slack: join the network" class:list={[social, 'cursor-pointer border-0 bg-transparent']}>
      <Icon name="slack" size={18} />
    </button>
  </div>
  <p class="m-0 font-mono text-[11px] text-vrc-muted">© 2026 VERT ROBO CON</p>
</Sheet>
