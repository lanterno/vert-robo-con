---
/**
 * Someone's portrait, or their initials when there is none, so a person
 * without a photo never shows a broken image (#33).
 */
import { initials, type Person } from '@/lib/content';

interface Props {
  person: Person;
  size?: number;
  class?: string;
}

const { person, size = 48, class: className } = Astro.props;
const letters = initials(person.name);
---

{
  person.photo ? (
    <img src={person.photo} alt="" width={size} height={size} loading="lazy" class:list={['shrink-0 bg-vrc-blue-tint object-cover', className]} />
  ) : (
    <span
      aria-hidden="true"
      class:list={['flex shrink-0 items-center justify-center bg-vrc-blue-tint font-mono text-vrc-blue', className]}
      style={`font-size:${Math.round(size * 0.32)}px`}
    >
      {letters}
    </span>
  )
}
