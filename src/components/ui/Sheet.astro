---
/**
 * A sheet: a panel over the page for a form, a profile or a list.
 *
 * A side sheet from the right on wider screens, as on HomeV3 and PeopleV3,
 * and a bottom sheet on phones, as on PhoneV3. Esc closes it, focus stays
 * inside while it is open, and it returns to the control that opened it.
 *
 * Open it from any element with `data-sheet-open={id}`; use a link with a
 * real href where there is a page to fall back to without JavaScript.
 *
 * `header` slot: extra controls beside Close, such as previous and next.
 *
 * For a sheet whose name changes, such as the person drawer, pass
 * `labelledby` with the id of a heading inside the content instead of a
 * `title`, and put anything to show in the title's place in the `lead` slot.
 */
type Props = {
  id: string;
  /** A small mono label above the title, such as "3 OF 12". */
  eyebrow?: string;
  /** Hide the title visually while keeping it as the sheet's name. */
  hideTitle?: boolean;
  /** `data-*` attributes go on the <dialog>, for scripts that build on it. */
  [data: `data-${string}`]: string | boolean | undefined;
} & ({ title: string; labelledby?: never } | { labelledby: string; title?: never });

const { id, title, eyebrow, hideTitle = false, labelledby, ...data } = Astro.props;
const titleId = labelledby ?? `${id}-title`;
---

<dialog
  id={id}
  data-sheet
  aria-labelledby={titleId}
  {...data}
  class:list={[
    'fixed m-0 max-w-none border-0 bg-white p-0 text-vrc-ink backdrop:bg-vrc-navy/50',
    // Phones: a bottom sheet.
    'inset-x-0 bottom-0 top-auto h-auto max-h-[85dvh] w-full rounded-t-3xl shadow-sheet-up',
    // Wider: a side sheet on the right, full height.
    'md:inset-y-0 md:left-auto md:right-0 md:h-dvh md:max-h-none md:w-[480px] md:max-w-full md:rounded-none md:shadow-sheet',
  ]}
>
  <div class="flex h-full max-h-[85dvh] flex-col md:max-h-none">
    <!-- The grab handle is for touch; the Close button is the keyboard path. -->
    <span aria-hidden="true" data-sheet-close class="flex h-7 shrink-0 cursor-pointer items-center justify-center md:hidden">
      <span class="h-[5px] w-10 rounded-full bg-vrc-line-strong"></span>
    </span>

    <div class="flex shrink-0 items-start justify-between gap-4 px-5 pb-4 md:px-7 md:pt-7">
      <div class="flex min-w-0 flex-col gap-1 self-center">
        {eyebrow && <span class="font-mono text-[11px] tracking-[0.06em] text-vrc-muted">{eyebrow}</span>}
        {
          title !== undefined ? (
            <h2 id={titleId} class:list={['m-0 font-heading text-2xl font-semibold tracking-[-0.02em]', hideTitle && 'sr-only']}>
              {title}
            </h2>
          ) : (
            <slot name="lead" />
          )
        }
      </div>
      <div class="flex shrink-0 items-center gap-1">
        <slot name="header" />
        <button
          type="button"
          data-sheet-close
          class="inline-flex min-h-11 items-center gap-1.5 rounded-[10px] bg-vrc-surface px-3 text-[15px] font-medium text-vrc-ink hover:bg-vrc-line"
        >
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          Close
        </button>
      </div>
    </div>

    <div class="flex flex-1 flex-col gap-6 overflow-y-auto overscroll-contain px-5 pb-7 md:px-7">
      <slot />
    </div>
  </div>
</dialog>

<script>
  import { initSheets } from '@/scripts/sheet';
  initSheets();
</script>
