---
/**
 * Interactive Leaflet map of the fictional Vert Robo Con organisations (demo data)
 */
import type { OrganizationEntry } from '@/lib/types';
import { ROBOTICS_TYPE_COLORS } from '@/lib/types';
import { LINKS, SITE } from '@/lib/constants';

interface Props {
  entries: OrganizationEntry[];
}

const { entries } = Astro.props;

// Pre-compute filter options
const continents = [...new Set(entries.map(e => e.continentHQ).filter(Boolean))].sort();
const roboticsTypes = [...new Set(entries.map(e => e.roboticsType).filter(Boolean))].sort();
const applications = [...new Set(entries.map(e => e.mainApplication).filter(Boolean))].sort();
const biomes = [...new Set(entries.map(e => e.biomeType).filter(Boolean))].sort();
const adaptationOptions = [...new Set(entries.map(e => e.adaptationMitigation).filter(Boolean))].sort();

// Pre-compute stats
const uniqueCountries = new Set(entries.map(e => e.countryHQ).filter(Boolean)).size;

// Count per robotics type (all of them, for multi-select chips)
const typeCounts = entries.reduce<Record<string, number>>((acc, e) => {
  if (e.roboticsType) acc[e.roboticsType] = (acc[e.roboticsType] ?? 0) + 1;
  return acc;
}, {});
const orderedTypes = Object.entries(typeCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([name]) => name);

// Decade buckets
const DECADES = [
  { key: 'pre2010', label: 'Pre-2010', test: (y: number | null) => y !== null && y < 2010 },
  { key: '2010s', label: '2010s', test: (y: number | null) => y !== null && y >= 2010 && y < 2020 },
  { key: '2020s', label: '2020s+', test: (y: number | null) => y !== null && y >= 2020 },
] as const;
const decadeCounts = DECADES.map(d => ({
  ...d,
  count: entries.filter(e => d.test(e.founded)).length,
}));

const DATA_URL = LINKS.map.data;
---

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.Default.css" />

<div class="climate-map-container" id="climate-map-container">
  <!-- Sidebar -->
  <aside class="map-sidebar" id="map-sidebar">
    <div class="sidebar-header">
      <h1 class="sidebar-title">{SITE.shortName} Organisation Map</h1>
      <div class="sidebar-stats">
        <div class="stat">
          <span class="stat-num" id="entry-count">{entries.length}</span>
          <span class="stat-label">orgs</span>
        </div>
        <div class="stat">
          <span class="stat-num" id="country-count">{uniqueCountries}</span>
          <span class="stat-label">countries</span>
        </div>
        <div class="stat">
          <span class="stat-num">{roboticsTypes.length}</span>
          <span class="stat-label">types</span>
        </div>
      </div>
      <a
        href={DATA_URL}
        download
        class="map-data-cta"
        title="Download the fictional demo dataset as JSON"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 4v12M6 10l6 6 6-6M5 20h14"/></svg>
        Download data (JSON)
      </a>
      <p class="map-demo-note">All organisations on this map are fictional demo data.</p>
    </div>

    <!-- Search -->
    <div class="sidebar-search">
      <div class="search-input-wrapper">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.35-4.35" />
        </svg>
        <input
          type="text"
          id="map-search"
          placeholder="Search name, country, application…"
          class="search-input"
          aria-label="Search organisations"
        />
        <button id="search-clear" class="search-clear" type="button" aria-label="Clear search" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
      <p class="search-hint"><kbd>/</kbd> to search · <kbd>esc</kbd> to clear</p>
    </div>

    <!-- Multi-select robotics type chips -->
    <div class="filter-row" aria-labelledby="type-chip-label">
      <span class="filter-row-label" id="type-chip-label">Robotics Type</span>
      <div class="quick-filters" role="group" aria-label="Filter by robotics type">
        <button class="chip" data-quick-type="" type="button" data-active="true">All</button>
        {orderedTypes.map(t => (
          <button
            class="chip"
            data-quick-type={t}
            type="button"
            style={`--chip-color:${ROBOTICS_TYPE_COLORS[t] ?? '#6b7280'}`}
          >
            <span class="chip-dot" style={`background:${ROBOTICS_TYPE_COLORS[t] ?? '#6b7280'}`}></span>
            {t.replace(/ Robot$/, '')}
            <span class="chip-count">{typeCounts[t]}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Founded-decade chips -->
    <div class="filter-row" aria-labelledby="decade-chip-label">
      <span class="filter-row-label" id="decade-chip-label">Founded</span>
      <div class="quick-filters" role="group" aria-label="Filter by founding decade">
        <button class="chip chip-sm" data-decade="" type="button" data-active="true">All</button>
        {decadeCounts.map(d => (
          <button class="chip chip-sm" data-decade={d.key} type="button">
            {d.label}
            <span class="chip-count">{d.count}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Dropdown filters -->
    <div class="sidebar-filters">
      <div class="filter-group">
        <label for="filter-continent">Continent</label>
        <select id="filter-continent" class="filter-select">
          <option value="">All Continents</option>
          {continents.map(c => <option value={c}>{c}</option>)}
        </select>
      </div>

      <div class="filter-group">
        <label for="filter-application">Application</label>
        <select id="filter-application" class="filter-select">
          <option value="">All Applications</option>
          {applications.map(a => <option value={a}>{a}</option>)}
        </select>
      </div>

      <div class="filter-group">
        <label for="filter-biome">Biome</label>
        <select id="filter-biome" class="filter-select">
          <option value="">All Biomes</option>
          {biomes.map(b => <option value={b}>{b}</option>)}
        </select>
      </div>

      <div class="filter-group">
        <label for="filter-adaptation">Climate Stance</label>
        <select id="filter-adaptation" class="filter-select">
          <option value="">Adaptation & Mitigation</option>
          {adaptationOptions.map(a => <option value={a}>{a}</option>)}
        </select>
      </div>

      <button id="clear-filters" class="clear-filters-btn" type="button">
        Clear Filters
        <span id="active-filter-count" class="active-count" hidden>0</span>
      </button>
    </div>

    <!-- Results List -->
    <div class="sidebar-results" id="sidebar-results">
      <!-- Populated by JS -->
    </div>

    <!-- Toggle button for mobile/collapse -->
    <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle sidebar" type="button">
      <svg class="toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M15 18l-6-6 6-6" />
      </svg>
    </button>
  </aside>

  <!-- Map Container -->
  <div class="map-wrapper" id="map-wrapper">
    <div id="leaflet-map" class="leaflet-map"></div>

    <!-- Map style toggle -->
    <div class="map-style-toggle" role="group" aria-label="Map style">
      <button class="style-btn" data-style="light" data-active="true" type="button" aria-label="Light map">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        Light
      </button>
      <button class="style-btn" data-style="dark" type="button" aria-label="Dark map">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        Dark
      </button>
      <button class="style-btn" data-style="satellite" type="button" aria-label="Satellite map">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10M12 2a15.3 15.3 0 0 0-4 10 15.3 15.3 0 0 0 4 10"/></svg>
        Satellite
      </button>
    </div>

    <!-- Reset view button -->
    <button id="reset-view" class="reset-view-btn" type="button" aria-label="Reset map view">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5"/></svg>
      Reset view
    </button>

    <!-- Legend -->
    <div class="map-legend" id="map-legend">
      <button class="legend-toggle" id="legend-toggle" type="button" aria-expanded="true" aria-controls="legend-body">
        <span class="legend-title">Robotics Type</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <ul class="legend-body" id="legend-body">
        {roboticsTypes.map(t => (
          <li class="legend-item">
            <span class="legend-dot" style={`background:${ROBOTICS_TYPE_COLORS[t] ?? '#6b7280'}`}></span>
            <span>{t}</span>
            <span class="legend-count">{typeCounts[t] ?? 0}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Map attribution overlay -->
    <div class="map-brand">
      {SITE.name}
    </div>
  </div>
</div>

<!-- Pass data to client-side script -->
<script define:vars={{ entries, ROBOTICS_TYPE_COLORS }}>
  window.climateMapData = entries;
  window.roboticsTypeColors = ROBOTICS_TYPE_COLORS;
</script>

<script>
  // Load Leaflet scripts dynamically in correct order
  function loadScript(src) {
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = src;
      script.crossOrigin = '';
      script.onload = resolve;
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  async function loadLeaflet() {
    try {
      await loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js');
      await loadScript('https://unpkg.com/leaflet.markercluster@1.4.1/dist/leaflet.markercluster.js');
      initMap();
    } catch (error) {
      console.error('Failed to load Leaflet:', error);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadLeaflet);
  } else {
    loadLeaflet();
  }

  // Deterministic jitter for entries sharing the same country centroid.
  // Spreads stacked points into a small circle so each is individually clickable.
  function jitterEntries(entries) {
    const byCountry = new Map();
    entries.forEach(e => {
      // City-level points are already distinct; only spread country centroids.
      if (!e.coordinates || e.coordinateSource === 'city') return;
      const key = e.countryHQ || `${e.coordinates[0]},${e.coordinates[1]}`;
      if (!byCountry.has(key)) byCountry.set(key, []);
      byCountry.get(key).push(e);
    });

    byCountry.forEach(group => {
      if (group.length <= 1) return;
      // Deterministic ordering so the same dataset always renders identically
      group.sort((a, b) => a.id.localeCompare(b.id));
      // Spread on a fibonacci-spiral so larger groups still look organic.
      // ~30km offset per "ring" — big enough to be tappable, small enough to keep country context.
      const baseLat = group[0].coordinates[0];
      const latPerKm = 1 / 111;
      const lngPerKm = 1 / (111 * Math.cos((baseLat * Math.PI) / 180) || 1);
      group.forEach((e, i) => {
        if (i === 0) return; // first stays on centroid
        const r = Math.sqrt(i) * 22; // km
        const theta = i * 2.39996; // golden angle (radians)
        const dLat = r * Math.cos(theta) * latPerKm;
        const dLng = r * Math.sin(theta) * lngPerKm;
        e.coordinates = [e.coordinates[0] + dLat, e.coordinates[1] + dLng];
      });
    });

    return entries;
  }

  // Base layer URLs
  const TILE_LAYERS = {
    light: {
      url: 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
    },
    dark: {
      url: 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
    },
    satellite: {
      url: 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
      attribution: 'Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics',
      subdomains: '',
    },
  };

  function initMap() {
    const rawEntries = window.climateMapData || [];
    const typeColors = window.roboticsTypeColors || {};
    const entries = jitterEntries(rawEntries.map(e => ({ ...e, coordinates: e.coordinates ? [...e.coordinates] : null })));

    // Initialize map
    const map = L.map('leaflet-map', {
      center: [20, 0],
      zoom: 2,
      minZoom: 2,
      maxZoom: 18,
      zoomControl: false,
      worldCopyJump: true,
    });

    L.control.zoom({ position: 'topright' }).addTo(map);

    // Tile layer (swappable via style toggle)
    let activeStyle = 'light';
    let tileLayer = L.tileLayer(TILE_LAYERS.light.url, {
      attribution: TILE_LAYERS.light.attribution,
      subdomains: TILE_LAYERS.light.subdomains,
      maxZoom: 20,
    }).addTo(map);

    function setMapStyle(style) {
      const conf = TILE_LAYERS[style];
      if (!conf) return;
      map.removeLayer(tileLayer);
      tileLayer = L.tileLayer(conf.url, {
        attribution: conf.attribution,
        subdomains: conf.subdomains,
        maxZoom: 20,
      }).addTo(map);
      activeStyle = style;
      document.querySelectorAll('.style-btn').forEach(btn => {
        btn.dataset.active = btn.dataset.style === style ? 'true' : 'false';
      });
      document.getElementById('climate-map-container')?.setAttribute('data-map-style', style);
    }

    document.querySelectorAll('.style-btn').forEach(btn => {
      btn.addEventListener('click', () => setMapStyle(btn.dataset.style));
    });

    // Cluster group
    const markers = L.markerClusterGroup({
      chunkedLoading: true,
      spiderfyOnMaxZoom: true,
      showCoverageOnHover: false,
      zoomToBoundsOnClick: true,
      maxClusterRadius: 50,
      iconCreateFunction: function(cluster) {
        const count = cluster.getChildCount();
        let size = 'small';
        if (count > 50) size = 'large';
        else if (count > 10) size = 'medium';
        return L.divIcon({
          html: `<div class="cluster-marker cluster-${size}"><span>${count}</span></div>`,
          className: 'marker-cluster-custom',
          iconSize: L.point(40, 40)
        });
      }
    });

    const markerMap = new Map();
    const initialBounds = [];

    entries.forEach(entry => {
      if (!entry.coordinates) return;
      const [lat, lng] = entry.coordinates;
      const color = typeColors[entry.roboticsType] || '#6b7280';
      initialBounds.push([lat, lng]);

      const initials = (entry.name || '?').split(' ').map(w => w[0] || '').join('').slice(0, 2).toUpperCase();
      const safeName = escapeHtml(entry.name || '');
      // No external logos: every marker is an initials badge in the type colour.
      const icon = L.divIcon({
        html: `<div class="logo-marker fallback" style="--ring:${color}" role="img" aria-label="${safeName}"><span>${escapeHtml(initials)}</span></div>`,
        className: 'custom-marker',
        iconSize: [36, 36],
        iconAnchor: [18, 18],
        popupAnchor: [0, -18]
      });

      const marker = L.marker([lat, lng], { icon, title: entry.name });

      // Tooltip on hover (compact name)
      marker.bindTooltip(entry.name, {
        direction: 'top',
        offset: [0, -16],
        opacity: 0.95,
        className: 'marker-hover-tooltip',
      });

      // Build popup content
      const websiteHref = entry.website
        ? (entry.website.startsWith('http') ? entry.website : 'https://' + entry.website)
        : '';

      const tagBits = [];
      if (entry.roboticsType) tagBits.push(`<span class="popup-tag popup-tag-type" style="background:${color}1f;color:${color};border-color:${color}55">${escapeHtml(entry.roboticsType)}</span>`);
      if (entry.mainApplication) tagBits.push(`<span class="popup-tag">${escapeHtml(entry.mainApplication)}</span>`);
      if (entry.biomeType) tagBits.push(`<span class="popup-tag">${escapeHtml(entry.biomeType)}</span>`);
      if (entry.adaptationMitigation) tagBits.push(`<span class="popup-tag">${escapeHtml(entry.adaptationMitigation)}</span>`);

      const metaBits = [];
      if (entry.founded) metaBits.push(`<span><strong>Founded</strong> ${entry.founded}</span>`);
      if (entry.deploymentCountries && entry.deploymentCountries.length > 0) {
        const dc = entry.deploymentCountries.slice(0, 4).join(', ');
        const more = entry.deploymentCountries.length > 4 ? ` +${entry.deploymentCountries.length - 4} more` : '';
        metaBits.push(`<span><strong>Deployed in</strong> ${escapeHtml(dc)}${more}</span>`);
      }

      const linkBits = [];
      if (websiteHref) linkBits.push(`<a href="${websiteHref}" target="_blank" rel="noopener" class="popup-link">Website <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 17 17 7M8 7h9v9"/></svg></a>`);

      marker.bindPopup(`
        <div class="map-popup">
          <div class="popup-header">
            <span class="popup-logo popup-initials" style="background:${color}" aria-hidden="true">${escapeHtml(initials)}</span>
            <div class="popup-header-text">
              <h3 class="popup-title">${escapeHtml(entry.name)}</h3>
              <p class="popup-location">${escapeHtml(entry.countryHQ || '')}${entry.continentHQ ? ` · ${escapeHtml(entry.continentHQ)}` : ''}</p>
            </div>
          </div>
          ${entry.description ? `<p class="popup-description">${escapeHtml(entry.description)}</p>` : ''}
          ${metaBits.length ? `<div class="popup-meta">${metaBits.join('')}</div>` : ''}
          ${tagBits.length ? `<div class="popup-tags">${tagBits.join('')}</div>` : ''}
          ${linkBits.length ? `<div class="popup-actions">${linkBits.join('')}</div>` : ''}
        </div>
      `, {
        maxWidth: 340,
        className: 'custom-popup'
      });

      markerMap.set(entry.id, { marker, entry });
      markers.addLayer(marker);
    });

    map.addLayer(markers);

    // Fit bounds
    let homeBounds = null;
    if (initialBounds.length > 0) {
      homeBounds = L.latLngBounds(initialBounds);
      map.fitBounds(homeBounds, { padding: [50, 50] });
    }

    // ─── Filter state & URL sync ───
    const searchInput = document.getElementById('map-search');
    const searchClear = document.getElementById('search-clear');
    const continentFilter = document.getElementById('filter-continent');
    const applicationFilter = document.getElementById('filter-application');
    const biomeFilter = document.getElementById('filter-biome');
    const adaptationFilter = document.getElementById('filter-adaptation');
    const clearFiltersBtn = document.getElementById('clear-filters');
    const activeCountEl = document.getElementById('active-filter-count');
    const resultsContainer = document.getElementById('sidebar-results');
    const entryCountEl = document.getElementById('entry-count');
    const countryCountEl = document.getElementById('country-count');
    const typeChips = document.querySelectorAll('[data-quick-type]');
    const decadeChips = document.querySelectorAll('[data-decade]');

    // Multi-select state for robotics types and single-select for decade
    const activeTypes = new Set();
    let activeDecade = '';

    const DECADE_TEST = {
      pre2010: (y) => y !== null && y < 2010,
      '2010s': (y) => y !== null && y >= 2010 && y < 2020,
      '2020s': (y) => y !== null && y >= 2020,
    };

    // Read URL params on init
    const params = new URLSearchParams(window.location.search);
    if (searchInput && params.get('q')) searchInput.value = params.get('q');
    if (continentFilter && params.get('continent')) continentFilter.value = params.get('continent');
    if (applicationFilter && params.get('app')) applicationFilter.value = params.get('app');
    if (biomeFilter && params.get('biome')) biomeFilter.value = params.get('biome');
    if (adaptationFilter && params.get('adapt')) adaptationFilter.value = params.get('adapt');
    if (params.get('type')) {
      params.get('type').split(',').filter(Boolean).forEach(t => activeTypes.add(t));
    }
    if (params.get('decade') && DECADE_TEST[params.get('decade')]) {
      activeDecade = params.get('decade');
    }

    function syncTypeChips() {
      typeChips.forEach(chip => {
        const t = chip.dataset.quickType;
        const active = t === '' ? activeTypes.size === 0 : activeTypes.has(t);
        chip.dataset.active = active ? 'true' : 'false';
      });
    }
    function syncDecadeChips() {
      decadeChips.forEach(chip => {
        chip.dataset.active = (chip.dataset.decade === activeDecade) ? 'true' : 'false';
      });
    }

    function updateUrl() {
      const p = new URLSearchParams();
      if (searchInput?.value) p.set('q', searchInput.value);
      if (continentFilter?.value) p.set('continent', continentFilter.value);
      if (applicationFilter?.value) p.set('app', applicationFilter.value);
      if (biomeFilter?.value) p.set('biome', biomeFilter.value);
      if (adaptationFilter?.value) p.set('adapt', adaptationFilter.value);
      if (activeTypes.size > 0) p.set('type', [...activeTypes].join(','));
      if (activeDecade) p.set('decade', activeDecade);
      const qs = p.toString();
      const newUrl = window.location.pathname + (qs ? `?${qs}` : '') + window.location.hash;
      window.history.replaceState(null, '', newUrl);
    }

    function applyFilters() {
      const search = searchInput?.value?.toLowerCase().trim() || '';
      const continent = continentFilter?.value || '';
      const application = applicationFilter?.value || '';
      const biome = biomeFilter?.value || '';
      const adaptation = adaptationFilter?.value || '';
      const decadeTest = activeDecade && DECADE_TEST[activeDecade];

      markers.clearLayers();
      const visibleEntries = [];
      const visibleCountries = new Set();

      markerMap.forEach(({ marker, entry }) => {
        let visible = true;

        if (search) {
          const hay = [
            entry.name,
            entry.description,
            entry.countryHQ,
            entry.continentHQ,
            entry.roboticsType,
            entry.mainApplication,
            entry.additionalApplication,
            entry.biomeType,
            ...(entry.deploymentCountries || []),
          ].join(' ').toLowerCase();
          if (!hay.includes(search)) visible = false;
        }

        if (visible && continent && entry.continentHQ !== continent) visible = false;
        if (visible && activeTypes.size > 0 && !activeTypes.has(entry.roboticsType)) visible = false;
        if (visible && application && entry.mainApplication !== application) visible = false;
        if (visible && biome && entry.biomeType !== biome) visible = false;
        if (visible && adaptation && entry.adaptationMitigation !== adaptation) visible = false;
        if (visible && decadeTest && !decadeTest(entry.founded)) visible = false;

        if (visible) {
          markers.addLayer(marker);
          visibleEntries.push(entry);
          if (entry.countryHQ) visibleCountries.add(entry.countryHQ);
        }
      });

      if (entryCountEl) entryCountEl.textContent = visibleEntries.length.toString();
      if (countryCountEl) countryCountEl.textContent = visibleCountries.size.toString();

      // Active filter count
      const activeFilters =
        [continent, application, biome, adaptation].filter(Boolean).length
        + (search ? 1 : 0)
        + (activeTypes.size > 0 ? 1 : 0)
        + (activeDecade ? 1 : 0);
      if (activeCountEl) {
        if (activeFilters > 0) {
          activeCountEl.textContent = activeFilters.toString();
          activeCountEl.hidden = false;
        } else {
          activeCountEl.hidden = true;
        }
      }
      if (searchClear) searchClear.hidden = !search;
      syncTypeChips();
      syncDecadeChips();
      updateUrl();
      renderResultsList(visibleEntries);
    }

    // Deep-link: open a specific startup's popup when ?startup=<id> is in the URL.
    // Also keep the URL in sync as the user opens/closes popups so it's shareable.
    function openStartup(id, options) {
      const data = markerMap.get(id);
      if (!data) return false;
      const { marker, entry } = data;
      // If filters are hiding this marker, temporarily show it
      if (!markers.hasLayer(marker)) markers.addLayer(marker);
      // marker-cluster's zoomToShowLayer zooms/spiderfies as needed so the
      // marker becomes individually visible before we open its popup.
      if (typeof markers.zoomToShowLayer === 'function') {
        markers.zoomToShowLayer(marker, () => marker.openPopup());
      } else {
        map.setView(entry.coordinates, Math.max(map.getZoom(), 10), { animate: options?.animate ?? true });
        setTimeout(() => marker.openPopup(), options?.animate === false ? 0 : 300);
      }
      return true;
    }

    function setStartupInUrl(id) {
      const p = new URLSearchParams(window.location.search);
      if (id) p.set('startup', id);
      else p.delete('startup');
      const qs = p.toString();
      window.history.replaceState(null, '', window.location.pathname + (qs ? `?${qs}` : '') + window.location.hash);
    }

    map.on('popupopen', (e) => {
      // Find the marker whose popup just opened and write its id to the URL
      for (const [id, { marker }] of markerMap.entries()) {
        if (marker.getPopup && marker.getPopup() === e.popup) {
          setStartupInUrl(id);
          break;
        }
      }
    });
    map.on('popupclose', () => setStartupInUrl(''));

    function renderResultsList(list) {
      if (!resultsContainer) return;

      if (list.length === 0) {
        resultsContainer.innerHTML = `
          <div class="empty-state">
            <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <p>No organisations match these filters.</p>
            <button class="empty-clear" type="button">Clear filters</button>
          </div>
        `;
        resultsContainer.querySelector('.empty-clear')?.addEventListener('click', () => clearAllFilters());
        return;
      }

      const displayEntries = list.slice(0, 100);

      resultsContainer.innerHTML = displayEntries.map(entry => {
        const color = typeColors[entry.roboticsType] || '#6b7280';
        const initials = (entry.name || '?').split(' ').map(w => w[0] || '').join('').slice(0, 2).toUpperCase();
        return `
          <button class="result-card" data-id="${entry.id}" type="button">
            <div class="result-logo" style="--ring:${color}">
              <span class="logo-initials" style="background:${color}">${escapeHtml(initials)}</span>
            </div>
            <div class="result-info">
              <h4 class="result-name">${escapeHtml(entry.name)}</h4>
              <p class="result-location">
                <span class="result-type-dot" style="background:${color}"></span>
                ${escapeHtml(entry.countryHQ || 'Unknown')}${entry.founded ? ` · ${entry.founded}` : ''}
              </p>
              ${entry.mainApplication ? `<span class="result-tag">${escapeHtml(entry.mainApplication)}</span>` : ''}
            </div>
          </button>
        `;
      }).join('');

      if (list.length > 100) {
        resultsContainer.insertAdjacentHTML(
          'beforeend',
          `<p class="results-overflow">Showing 100 of ${list.length} — refine filters to narrow down</p>`
        );
      }

      resultsContainer.querySelectorAll('.result-card').forEach(card => {
        card.addEventListener('click', () => {
          const id = card.dataset.id;
          if (id) openStartup(id);
        });
      });
    }

    function clearAllFilters() {
      if (searchInput) searchInput.value = '';
      if (continentFilter) continentFilter.value = '';
      if (applicationFilter) applicationFilter.value = '';
      if (biomeFilter) biomeFilter.value = '';
      if (adaptationFilter) adaptationFilter.value = '';
      activeTypes.clear();
      activeDecade = '';
      applyFilters();
    }

    // Event listeners
    searchInput?.addEventListener('input', debounce(applyFilters, 250));
    continentFilter?.addEventListener('change', applyFilters);
    applicationFilter?.addEventListener('change', applyFilters);
    biomeFilter?.addEventListener('change', applyFilters);
    adaptationFilter?.addEventListener('change', applyFilters);

    searchClear?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      applyFilters();
      searchInput?.focus();
    });

    clearFiltersBtn?.addEventListener('click', clearAllFilters);

    typeChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const t = chip.dataset.quickType || '';
        if (t === '') {
          activeTypes.clear();
        } else if (activeTypes.has(t)) {
          activeTypes.delete(t);
        } else {
          activeTypes.add(t);
        }
        applyFilters();
      });
    });

    decadeChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const d = chip.dataset.decade || '';
        activeDecade = (activeDecade === d) ? '' : d; // toggle single-select
        applyFilters();
      });
    });

    // Reset view
    document.getElementById('reset-view')?.addEventListener('click', () => {
      if (homeBounds) map.fitBounds(homeBounds, { padding: [50, 50], animate: true });
    });

    // Legend collapse
    const legend = document.getElementById('map-legend');
    document.getElementById('legend-toggle')?.addEventListener('click', () => {
      legend?.classList.toggle('collapsed');
      const expanded = !legend?.classList.contains('collapsed');
      document.getElementById('legend-toggle')?.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    });

    // Sidebar toggle
    const sidebar = document.getElementById('map-sidebar');
    const container = document.getElementById('climate-map-container');
    document.getElementById('sidebar-toggle')?.addEventListener('click', () => {
      sidebar?.classList.toggle('collapsed');
      container?.classList.toggle('sidebar-collapsed');
      setTimeout(() => map.invalidateSize(), 320);
    });

    // Keyboard shortcuts: "/" focuses search, "Escape" clears, "Esc" closes popup
    document.addEventListener('keydown', (ev) => {
      const target = ev.target;
      const inField = target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.tagName === 'SELECT');
      if (ev.key === '/' && !inField) {
        ev.preventDefault();
        searchInput?.focus();
        searchInput?.select?.();
      } else if (ev.key === 'Escape') {
        if (document.activeElement === searchInput && searchInput.value) {
          searchInput.value = '';
          applyFilters();
        } else {
          map.closePopup();
        }
      }
    });

    // Initial render (picks up URL params for filters)
    applyFilters();

    // If the URL has ?startup=<id>, open that startup's popup after layout settles.
    // We also accept the legacy ?org=<id> param for back-compat with the first
    // shipped version of this page.
    const startupParam = params.get('startup') || params.get('org');
    if (startupParam) {
      setTimeout(() => openStartup(startupParam, { animate: false }), 250);
    }

    // Tiny HTML-escape util
    function escapeHtml(str) {
      if (str == null) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function debounce(fn, delay) {
      let timeout;
      return function(...args) {
        clearTimeout(timeout);
        timeout = setTimeout(() => fn.apply(this, args), delay);
      };
    }
  }
</script>

