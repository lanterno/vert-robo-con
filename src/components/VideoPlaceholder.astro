---
/**
 * VideoPlaceholder Component
 * A neutral 16:9 card that stands in for a recording. The site has no real
 * videos, so every recording slot renders this instead of an embed.
 */
interface Props {
  title: string;
  caption?: string;
  class?: string;
}

const { title, caption, class: className = '' } = Astro.props;
---

<div
  class={`video-placeholder relative aspect-video w-full overflow-hidden rounded-xl bg-gray-100 border border-gray-200 text-gray-700 flex flex-col items-center justify-center text-center p-6 ${className}`}
  role="img"
  aria-label={`Recording placeholder: ${title}`}
>
  <div class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-white shadow-md flex items-center justify-center mb-4">
    <svg class="w-7 h-7 md:w-8 md:h-8 text-gray-400 ml-1" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 5v14l11-7z" />
    </svg>
  </div>
  <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-gray-600 mb-2">
    Recording placeholder
  </span>
  <span class="font-heading font-semibold text-gray-900 text-sm md:text-base max-w-md line-clamp-2">
    {title}
  </span>
  {caption && (
    <span class="text-gray-600 text-xs md:text-sm mt-2 max-w-md">
      {caption}
    </span>
  )}
</div>
