---
import { SITE, LINKS } from '@/lib/constants';

const currentYear = new Date().getFullYear();

const chatIcon = 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Consulting', href: '/consulting' },
  { label: 'Research', href: '/research' },
  { label: 'Summits', href: '/summits' },
  { label: 'Map', href: '/map' },
  { label: 'Community', href: '/slack' },
];

const resourceLinks = [
  { label: 'White Paper', href: LINKS.research.whitePaper },
  { label: 'Map Data (JSON)', href: LINKS.map.data },
  { label: 'Summit 2025 Recordings', href: '/summits/2025' },
  { label: 'Partner Info', href: LINKS.summit.sponsorInfo },
];

const quickLinks = [
  {
    label: 'Email',
    href: LINKS.contact.mailto,
    external: false,
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
  {
    label: 'Summit recordings',
    href: LINKS.social.videos,
    external: false,
    icon: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664zM21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    label: 'Community workspace',
    href: LINKS.community.join,
    external: true,
    icon: chatIcon,
  },
];
---

<footer class="bg-vrc-navy text-white">
  {/* Main Footer Content */}
  <div class="container mx-auto px-4 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12">
      {/* Brand & Description */}
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-3 mb-4">
          <img src="/images/logo.svg" alt={`${SITE.shortName} logo`} class="h-10 w-10" />
          <span class="font-heading font-bold text-xl">{SITE.name}</span>
        </a>
        <p class="text-gray-400 text-sm mb-6">
          {SITE.description}
        </p>

        {/* Quick Links */}
        <div class="flex items-center gap-4">
          {quickLinks.map(link => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center hover:bg-vrc-blue transition-colors"
              aria-label={link.label}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={link.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      {/* Navigation Links */}
      <div>
        <h3 class="font-heading font-semibold text-lg mb-4">Navigation</h3>
        <ul class="space-y-3">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="text-gray-400 hover:text-white transition-colors text-sm"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Resources */}
      <div>
        <h3 class="font-heading font-semibold text-lg mb-4">Resources</h3>
        <ul class="space-y-3">
          {resourceLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="text-gray-400 hover:text-white transition-colors text-sm inline-flex items-center gap-1"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Join CTA */}
      <div>
        <h3 class="font-heading font-semibold text-lg mb-4">Join the Community</h3>
        <p class="text-gray-400 text-sm mb-4">
          Meet {SITE.stats.members} members in {SITE.stats.countries} countries who build robots for climate work.
        </p>
        <a
          href={LINKS.community.join}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 bg-vrc-green text-white font-semibold text-sm uppercase tracking-wider hover:bg-vrc-green-dark transition-colors rounded-lg"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={chatIcon} />
          </svg>
          Join Now
        </a>

        {/* Stats */}
        <div class="mt-6 grid grid-cols-3 gap-4 text-center">
          <div>
            <span class="block text-2xl font-heading font-bold text-white">{SITE.stats.members}</span>
            <span class="text-gray-500 text-xs uppercase tracking-wide">Members</span>
          </div>
          <div>
            <span class="block text-2xl font-heading font-bold text-white">{SITE.stats.countries}</span>
            <span class="text-gray-500 text-xs uppercase tracking-wide">Countries</span>
          </div>
          <div>
            <span class="block text-2xl font-heading font-bold text-white">{SITE.stats.sectors}</span>
            <span class="text-gray-500 text-xs uppercase tracking-wide">Sectors</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Bottom Bar */}
  <div class="border-t border-white/10">
    <div class="container mx-auto px-4 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="text-center md:text-left">
          <p class="text-gray-500 text-sm">
            © {currentYear} Vert Robo Con (fictional). Code under MIT.
          </p>
          <p class="text-gray-500 text-xs mt-1">
            All people, organisations, events and images on this site are fictional demo content.
          </p>
        </div>

        <div class="flex items-center gap-6">
          <a href={LINKS.contact.mailto} class="text-gray-500 hover:text-white text-sm transition-colors">
            Contact
          </a>
          <a href={LINKS.community.codeOfConduct} class="text-gray-500 hover:text-white text-sm transition-colors">
            Code of Conduct
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
